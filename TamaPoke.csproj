<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Resource\monsterball.ico</ApplicationIcon>
    <UseWindowsForms>True</UseWindowsForms>
    <DisableWinFormsImplicitUsings>true</DisableWinFormsImplicitUsings>
    <FileVersion>4.11.3.0</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
    <None Remove="Data\**" />
    <Page Remove="Data\**" />
  </ItemGroup>

  <!-- 전투 테스트는 별도 프로젝트입니다. (Tests/BattleTests) -->
  <ItemGroup>
    <Compile Remove="Tests\**" />
    <EmbeddedResource Remove="Tests\**" />
    <None Remove="Tests\**" />
    <Page Remove="Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Resource\monsterball.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <!-- 다국어 문구 (Utils/Loc.cs에서 "Lang.{언어}.json" 이름으로 읽음) -->
  <ItemGroup>
    <EmbeddedResource Include="Lang\*.json" LogicalName="Lang.%(Filename).json" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <!-- 대기 화면 픽셀 UI (버튼/아이콘): 실행 파일 안에 포함 (XAML에서 /TamaPoke;component/Assets/UI/... 로 사용) -->
  <ItemGroup>
    <None Remove="Assets\UI\**" />
    <Resource Include="Assets\UI\*.png" />
  </ItemGroup>

  <ItemGroup>
    <None Update="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateVersionJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Visual Studio 속성에 입력한 파일 버전(FileVersion)을 가져옵니다 -->
      <AppVersion>$(FileVersion)</AppVersion>
      <!-- 버전이 비어있을 경우의 안전장치 -->
      <AppVersion Condition="'$(AppVersion)' == ''">1.0.0.0</AppVersion>
      
      <!-- version.json에 들어갈 텍스트 포맷 (GitHub 다운로드 URL 자동 조합) -->
      <JsonContent>{
  "Version": "$(AppVersion)",
  "DownloadUrl": "https://github.com/gomdolit-jeong/TamaPoke_PC/releases/download/v$(AppVersion)/TamaPoke_v$(AppVersion).zip"
}</JsonContent>
    </PropertyGroup>

    <!-- 출력 폴더(bin/Debug 등)에 version.json 파일을 자동으로 기록합니다 -->
    <WriteLinesToFile File="$(OutDir)version.json" Lines="$(JsonContent)" Overwrite="true" Encoding="UTF-8" />
	
	<!-- 유저님이 Git 커밋을 하시는 원본 소스 폴더에도 version.json을 똑같이 갱신합니다! -->
	<WriteLinesToFile File="$(MSBuildProjectDirectory)\version.json" Lines="$(JsonContent)" Overwrite="true" Encoding="UTF-8" />
  </Target>


</Project>
