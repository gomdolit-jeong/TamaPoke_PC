<Project Sdk="Microsoft.NET.Sdk">
  
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>Assets\Resource\monsterball.ico</ApplicationIcon>
    <UseWindowsForms>True</UseWindowsForms>
    <DisableWinFormsImplicitUsings>true</DisableWinFormsImplicitUsings>
    <FileVersion>4.8.6.1</FileVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <EmbeddedResource Remove="Data\**" />
    <None Remove="Data\**" />
    <Page Remove="Data\**" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Converters\SpriteConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Assets\Resource\Badges\Badge_1.png" />
    <None Remove="Assets\Resource\Badges\Badge_10.png" />
    <None Remove="Assets\Resource\Badges\Badge_11.png" />
    <None Remove="Assets\Resource\Badges\Badge_12.png" />
    <None Remove="Assets\Resource\Badges\Badge_13.png" />
    <None Remove="Assets\Resource\Badges\Badge_14.png" />
    <None Remove="Assets\Resource\Badges\Badge_15.png" />
    <None Remove="Assets\Resource\Badges\Badge_16.png" />
    <None Remove="Assets\Resource\Badges\Badge_17.png" />
    <None Remove="Assets\Resource\Badges\Badge_18.png" />
    <None Remove="Assets\Resource\Badges\Badge_19.png" />
    <None Remove="Assets\Resource\Badges\Badge_2.png" />
    <None Remove="Assets\Resource\Badges\Badge_20.png" />
    <None Remove="Assets\Resource\Badges\Badge_21.png" />
    <None Remove="Assets\Resource\Badges\Badge_22.png" />
    <None Remove="Assets\Resource\Badges\Badge_23.png" />
    <None Remove="Assets\Resource\Badges\Badge_24.png" />
    <None Remove="Assets\Resource\Badges\Badge_25.png" />
    <None Remove="Assets\Resource\Badges\Badge_26.png" />
    <None Remove="Assets\Resource\Badges\Badge_27.png" />
    <None Remove="Assets\Resource\Badges\Badge_28.png" />
    <None Remove="Assets\Resource\Badges\Badge_29.png" />
    <None Remove="Assets\Resource\Badges\Badge_3.png" />
    <None Remove="Assets\Resource\Badges\Badge_30.png" />
    <None Remove="Assets\Resource\Badges\Badge_31.png" />
    <None Remove="Assets\Resource\Badges\Badge_32.png" />
    <None Remove="Assets\Resource\Badges\Badge_4.png" />
    <None Remove="Assets\Resource\Badges\Badge_5.png" />
    <None Remove="Assets\Resource\Badges\Badge_6.png" />
    <None Remove="Assets\Resource\Badges\Badge_7.png" />
    <None Remove="Assets\Resource\Badges\Badge_8.png" />
    <None Remove="Assets\Resource\Badges\Badge_9.png" />
    <None Remove="Assets\Resource\PokemonSprites.zip" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\Resource\monsterball.ico">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <None Include="Utils\SpriteConverter.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Emoji.Wpf" Version="0.3.4" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Assets\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup>
    <None Update="version.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="GenerateVersionJson" AfterTargets="Build">
    <PropertyGroup>
      <!-- Visual Studio 속성에 입력한 파일 버전(FileVersion)을 가져옵니다 -->
      <AppVersion>$(FileVersion)</AppVersion>
      <!-- 버전이 비어있을 경우의 안전장치 -->
      <AppVersion Condition="'$(AppVersion)' == ''">1.0.0.0</AppVersion>
      
      <!-- version.json에 들어갈 텍스트 포맷 (GitHub 다운로드 URL 자동 조합) -->
      <JsonContent>{
  "Version": "$(AppVersion)",
  "DownloadUrl": "https://github.com/gomdolit-jeong/TamaPoke_PC/releases/download/v$(AppVersion)/TamaPoke_v$(AppVersion).zip"
}</JsonContent>
    </PropertyGroup>

    <!-- 출력 폴더(bin/Debug 등)에 version.json 파일을 자동으로 기록합니다 -->
    <WriteLinesToFile File="$(OutDir)version.json" Lines="$(JsonContent)" Overwrite="true" Encoding="UTF-8" />
  </Target>


</Project>
