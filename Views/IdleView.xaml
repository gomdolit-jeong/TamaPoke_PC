<UserControl x:Class="TamaPoke.Views.IdleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             xmlns:views="clr-namespace:TamaPoke.Views"
             mc:Ignorable="d" 
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             RenderOptions.BitmapScalingMode="NearestNeighbor"
             Height="320" Width="350">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 픽셀 버튼/상자/바 (배틀 화면과 함께 씀) -->
            <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <conv:ProgressBarColorConverter x:Key="BarColorConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <Style TargetType="TextBlock" x:Key="DynamicTextStyle">
            <Setter Property="Foreground" Value="#2a2a36"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="White" BlurRadius="5" ShadowDepth="0" Opacity="0.9"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNight}" Value="True">
                    <Setter Property="Foreground" Value="#d8dcf0"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect Color="Black" BlurRadius="4" ShadowDepth="1" Opacity="0.9"/>
                        </Setter.Value>
                    </Setter>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#E0E0E0"/>
        </Style>

        <!-- 씻기(거품) 애니메이션 -->
        <!-- 거품마다 가로 위치(Margin)는 그대로 두고 위로만 떠오르게 합니다. -->
        <Style TargetType="Image" x:Key="BubbleStyle">
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
            <Setter Property="Opacity" Value="0"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <TranslateTransform Y="0"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsBathing}" Value="True">
                    <DataTrigger.EnterActions>
                        <BeginStoryboard Name="bubbleAnim">
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="10" To="-130" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1.5" RepeatBehavior="Forever"/>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <DataTrigger.ExitActions>
                        <StopStoryboard BeginStoryboardName="bubbleAnim"/>
                    </DataTrigger.ExitActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 🌟 밥 먹기 애니메이션: 반쪽씩 베어 먹는(Cropping) 연출로 완벽 변경 -->
        <Style TargetType="Image" x:Key="FoodAnimStyle">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
            <Setter Property="Clip">
                <Setter.Value>
                    <RectangleGeometry Rect="0,0,36,36"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEating}" Value="True">
                    <Setter Property="Visibility" Value="Visible"/>
                    <DataTrigger.EnterActions>
                        <!-- 🌟 이름(Name)을 부여하지 않고 바로 실행시켜 버그를 방지합니다. -->
                        <BeginStoryboard>
                            <Storyboard>
                                <RectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Clip).(RectangleGeometry.Rect)">
                                    <DiscreteRectKeyFrame KeyTime="0:0:0.0" Value="0,0,36,36" />
                                    <DiscreteRectKeyFrame KeyTime="0:0:0.7" Value="0,0,24,36" />
                                    <DiscreteRectKeyFrame KeyTime="0:0:1.4" Value="0,0,12,36" />
                                    <DiscreteRectKeyFrame KeyTime="0:0:2.1" Value="0,0,0,36" />
                                </RectAnimationUsingKeyFrames>

                                <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                    <LinearDoubleKeyFrame KeyTime="0:0:0.0" Value="1.0" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:1.8" Value="1.0" />
                                    <LinearDoubleKeyFrame KeyTime="0:0:2.1" Value="0.0" />
                                </DoubleAnimationUsingKeyFrames>
                            </Storyboard>
                        </BeginStoryboard>
                    </DataTrigger.EnterActions>
                    <!-- 🌟 말썽을 일으키던 ExitActions (StopStoryboard) 구간을 완전히 삭제했습니다. -->
                </DataTrigger>
            </Style.Triggers>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid HorizontalAlignment="Center">
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E53935" Offset="0.0" />
                    <GradientStop Color="#E53935" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- 메인 게임 영역 -->
            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">

                <Grid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="{u:T idle.menu.dex}" Click="MenuDex_Click"/>
                        <MenuItem Header="{u:T idle.menu.profile}" Click="MenuProfile_Click"/>
                        <MenuItem Header="{u:T idle.menu.party}" Click="MenuItem_OpenParty_Click"/>
                        <MenuItem Header="{u:T idle.menu.bag}" Click="MenuInventory_Click"/>
                        <Separator/>
                        <MenuItem Header="{u:T idle.menu.release}" Click="MenuRelease_Click"/>
                    </ContextMenu>
                </Grid.ContextMenu>

                <Grid>
                    <Grid.Clip>
                        <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                    </Grid.Clip>

                    <Grid.RowDefinitions>
                        <RowDefinition Height="45*"/>
                        <RowDefinition Height="20*"/>
                        <RowDefinition Height="35*"/>
                    </Grid.RowDefinitions>

                    <Image Grid.RowSpan="3" Source="{Binding BackgroundImage}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                    <!-- 해/달은 배경 그림(96x96 픽셀 아트)에 함께 그려져 있습니다. (동굴은 하늘이 없어 해/달도 없음) -->

                    <StackPanel Grid.Row="0" Margin="0,20,0,0" HorizontalAlignment="Center">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Name}" Style="{StaticResource DynamicTextStyle}" FontSize="16" FontWeight="Bold" FontFamily="Consolas" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LevelDisplay}" Style="{StaticResource DynamicTextStyle}" FontSize="16" FontWeight="Bold" FontFamily="Consolas"/>
                        </StackPanel>
                        <TextBlock Text="{Binding MoodText}" Style="{StaticResource DynamicTextStyle}" Opacity="0.8" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,2,0,0" FontFamily="Consolas" TextAlignment="Center"/>
                    </StackPanel>

                    <Grid Grid.RowSpan="3">

                        <!-- 🌟 1. 알(Egg) 상태: 불필요한 바인딩 완전 제거, 크기 직관적 고정, 중앙 정렬 -->
                        <Grid Visibility="{Binding IsEgg, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding CurrentFrame}" Stretch="None" 
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,15,0,0"
                                   Cursor="Hand" MouseLeftButtonDown="PetImage_MouseLeftButtonDown"
                                   RenderOptions.BitmapScalingMode="NearestNeighbor"
                                   RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="3.0" ScaleY="3.0"/>
                                </Image.LayoutTransform>
                            </Image>
                        </Grid>

                        <!-- 🌟 2. 살아있는 포켓몬 상태: 걷기와 방향 턴을 위해 TransformGroup 필수 유지! -->
                        <Grid Visibility="{Binding IsAliveAndNotEgg, Converter={StaticResource BoolToVis}}">
                            <Image Source="{Binding CurrentFrame}" Stretch="None" Margin="0,15,0,0" Cursor="Hand" 
                                   MouseLeftButtonDown="PetImage_MouseLeftButtonDown" 
                                   RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                <Image.LayoutTransform>
                                    <ScaleTransform ScaleX="2.0" ScaleY="2.0"/>
                                </Image.LayoutTransform>
                                <Image.RenderTransform>
                                    <!-- 👇 포켓몬이 걷고 뒤돌기 위해 꼭 필요한 코드입니다! 👇 -->
                                    <TransformGroup>
                                        <ScaleTransform ScaleX="{Binding FlipX}"/>
                                        <TranslateTransform X="{Binding PosX}" Y="{Binding PosY}"/>
                                    </TransformGroup>
                                </Image.RenderTransform>
                            </Image>

                            <!-- 응가: 개수만큼 픽셀 응가 (9x9 → 3배) -->
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,40,100" IsHitTestVisible="False">
                                <Image Source="/TamaPoke;component/Assets/UI/fx_poop.png" Width="27" Height="27" Margin="2,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Poops}" Value="1"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Poops}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Poops}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Image Source="/TamaPoke;component/Assets/UI/fx_poop.png" Width="27" Height="27" Margin="2,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Poops}" Value="2"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Poops}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                                <Image Source="/TamaPoke;component/Assets/UI/fx_poop.png" Width="27" Height="27" Margin="2,0" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Poops}" Value="3"><Setter Property="Visibility" Value="Visible"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>
                            </StackPanel>
                            <Image Source="{Binding CurrentFoodImage}" Style="{StaticResource FoodAnimStyle}" Width="36" Height="36" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="80,20,0,0"/>
                            <Image Source="/TamaPoke;component/Assets/UI/fx_zzz.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"
                                   Visibility="{Binding IsSleeping, Converter={StaticResource BoolToVis}}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="40,-110,0,0"/>

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsBathing, Converter={StaticResource BoolToVis}}">
                                <Image Source="/TamaPoke;component/Assets/UI/fx_bubble.png" Style="{StaticResource BubbleStyle}" Width="27" Height="27" Margin="-40,20,0,0"/>
                                <Image Source="/TamaPoke;component/Assets/UI/fx_bubble.png" Style="{StaticResource BubbleStyle}" Width="36" Height="36" Margin="30,40,0,0"/>
                                <Image Source="/TamaPoke;component/Assets/UI/fx_bubble.png" Style="{StaticResource BubbleStyle}" Width="18" Height="18" Margin="5,50,0,0"/>
                            </Grid>

                            <Grid HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,-30,-80,0" Opacity="0">
                                <Grid.Style>
                                    <Style TargetType="Grid">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPetting}" Value="True">
                                                <Setter Property="Visibility" Value="Visible"/>
                                                <DataTrigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <ThicknessAnimation Storyboard.TargetProperty="Margin" From="80,100,0,0" To="100,20,-50,0" Duration="0:0:1.0" />
                                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1.0" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </DataTrigger.EnterActions>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Grid.Style>
                                <Image Source="/TamaPoke;component/Assets/UI/icon_heart.png" Width="36" Height="36" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            </Grid>
                        </Grid>

                        <Grid Visibility="{Binding CanShowEvolvePrompt, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{u:T idle.evolve}" FontSize="14" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#E53935" Foreground="#FFFFFF" Padding="15,8" Click="Evolve_Click" Margin="0,0,5,0">
                                </Button>
                                <Button Content="{u:T idle.later}" FontSize="12" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#757575" Foreground="#FFFFFF" Padding="10,8" Click="PostponeEvolve_Click">
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CanShowFarewellPrompt, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="5">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="{u:T idle.farewell}" FontSize="12" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#FFD54F" Foreground="#4E342E" Padding="12,8" Click="StartFarewell_Click" Margin="0,0,5,0">
                                </Button>
                                <Button Content="{u:T idle.later}" FontSize="12" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#757575" Foreground="#FFFFFF" Padding="10,8" Click="PostponeFarewell_Click">
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Grid Visibility="{Binding CanRunawayNow, Converter={StaticResource BoolToVis}}" VerticalAlignment="Center" HorizontalAlignment="Center" Panel.ZIndex="5">
                            <Button Content="{u:T idle.runaway}" FontSize="14" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#78909C" Foreground="#FFFFFF" Padding="15,10" Click="StartRunaway_Click">
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- 상태 바: 픽셀 상자 안에 2x2로 (버튼 줄과 겹치지 않게 아래 여백을 둠) -->
                    <ContentControl Grid.Row="2" Style="{StaticResource PixelPanel}" Margin="36,4,36,0" VerticalAlignment="Top">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{u:T stat.fullness}" Style="{StaticResource PanelLabel}"/>
                            <ProgressBar Grid.Row="0" Grid.Column="1" Style="{StaticResource PixelBar}" Value="{Binding Fullness}" Foreground="{Binding Fullness, Converter={StaticResource BarColorConverter}}" ToolTip="{Binding Fullness, StringFormat={}{0} / 100}"/>
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="{u:T stat.joy}" Style="{StaticResource PanelLabel}" Margin="10,0,4,0"/>
                            <ProgressBar Grid.Row="0" Grid.Column="3" Style="{StaticResource PixelBar}" Value="{Binding Joy}" Foreground="{Binding Joy, Converter={StaticResource BarColorConverter}}" ToolTip="{Binding Joy, StringFormat={}{0} / 100}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{u:T stat.energy}" Style="{StaticResource PanelLabel}"/>
                            <ProgressBar Grid.Row="1" Grid.Column="1" Style="{StaticResource PixelBar}" Value="{Binding Energy}" Foreground="{Binding Energy, Converter={StaticResource BarColorConverter}}" ToolTip="{Binding Energy, StringFormat={}{0} / 100}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{u:T stat.hygiene}" Style="{StaticResource PanelLabel}" Margin="10,0,4,0"/>
                            <ProgressBar Grid.Row="1" Grid.Column="3" Style="{StaticResource PixelBar}" Value="{Binding Hygiene}" Foreground="{Binding Hygiene, Converter={StaticResource BarColorConverter}}" ToolTip="{Binding Hygiene, StringFormat={}{0} / 100}"/>
                        </Grid>
                    </ContentControl>

                    <Grid Grid.RowSpan="3" Panel.ZIndex="50">

                        <!-- 밥 주기 메뉴 팝업 (상태 바 상자를 그대로 덮음) -->
                        <ContentControl Style="{StaticResource PixelPanel}" Padding="6,4,6,2"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="36,0,36,55"
                                Visibility="{Binding IsFeedMenuOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T food.red}" Click="FeedItem_Click" Tag="0">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_berry_red.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T food.blue}" Click="FeedItem_Click" Tag="1">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_berry_blue.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T food.green}" Click="FeedItem_Click" Tag="2">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_berry_green.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T food.candy}" Click="FeedItem_Click" Tag="3">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_candy.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                            </StackPanel>
                        </ContentControl>

                        <!-- 미니게임 메뉴 팝업 (상태 바 상자를 그대로 덮음) -->
                        <ContentControl Style="{StaticResource PixelPanel}" Padding="6,4,6,2"
                                HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="36,0,36,55"
                                Visibility="{Binding IsPlayMenuOpen, Converter={StaticResource BoolToVis}}">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T game.ball}" Click="PlayBall_Click">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_ball.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T game.catch}" Click="PlayCatch_Click">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_catch.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T game.memo}" Click="PlayMemo_Click">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_memo.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                                <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T game.clean}" Click="PlayClean_Click">
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_clean.png" Style="{StaticResource PixelIcon}"/>
                                </Button>
                            </StackPanel>
                        </ContentControl>
                    </Grid>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,18">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsProfileOpen}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T idle.btn.feed}" Click="ToggleFeedMenu_Click" IsEnabled="{Binding IsAlive}">
                            <Image Source="/TamaPoke;component/Assets/UI/icon_feed.png" Style="{StaticResource PixelIcon}"/>
                        </Button>
                        <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T idle.btn.play}" Click="TogglePlayMenu_Click" IsEnabled="{Binding IsAlive}">
                            <Image Source="/TamaPoke;component/Assets/UI/icon_play.png" Style="{StaticResource PixelIcon}"/>
                        </Button>
                        <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T idle.btn.sleep}" Click="SleepButton_Click" IsEnabled="{Binding IsAlive}">
                            <Image Source="/TamaPoke;component/Assets/UI/icon_sleep.png" Style="{StaticResource PixelIcon}"/>
                        </Button>
                        <Button Style="{StaticResource PhysicalButton}" ToolTip="{u:T idle.btn.bath}" Click="CleanButton_Click" IsEnabled="{Binding IsAlive}">
                            <Image Source="/TamaPoke;component/Assets/UI/icon_bath.png" Style="{StaticResource PixelIcon}"/>
                        </Button>
                    </StackPanel>

                    <!-- 뷰 컨트롤 영역 -->
                    <views:ProfileCardView Grid.RowSpan="3" Visibility="{Binding IsProfileOpen, Converter={StaticResource BoolToVis}}"/>
                    <views:BattleView Grid.RowSpan="3" Visibility="{Binding IsBattleOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1500"/>
                    <views:PokemonDexView Grid.RowSpan="3" Visibility="{Binding IsDexOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1400"/>
                    <views:PartyView Grid.RowSpan="3" Visibility="{Binding IsPartyOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="1450"/>
                    <views:InventoryView Grid.RowSpan="3" Visibility="{Binding IsInventoryOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="10"/>

                    <Grid Visibility="{Binding IsCeremony, Converter={StaticResource BoolToVis}}" Background="#EE1A1A1A" Grid.RowSpan="3" Panel.ZIndex="99999" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="-15">
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,-30,0,0">
                            <Grid Width="100" Height="100">
                                <Image Source="{Binding CurrentFrame}" Width="100" Height="100" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                                    <Image.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform x:Name="EvolveScale" ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform X="{Binding PosX}" Y="{Binding PosY}"/>
                                        </TransformGroup>
                                    </Image.RenderTransform>
                                </Image>

                                <Rectangle Fill="White" Width="100" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding IsEvolvingFlash, Converter={StaticResource BoolToVis}}">
                                    <Rectangle.RenderTransform>
                                        <TransformGroup>
                                            <ScaleTransform ScaleX="1" ScaleY="1"/>
                                            <TranslateTransform X="{Binding PosX}" Y="{Binding PosY}"/>
                                        </TransformGroup>
                                    </Rectangle.RenderTransform>
                                    <Rectangle.OpacityMask>
                                        <ImageBrush ImageSource="{Binding CurrentFrame}" Stretch="Uniform"/>
                                    </Rectangle.OpacityMask>
                                    <Rectangle.Style>
                                        <Style TargetType="Rectangle">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEvolvingFlash}" Value="True">
                                                    <DataTrigger.EnterActions>
                                                        <BeginStoryboard Name="FlashAnim">
                                                            <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.0" To="1.0" Duration="0:0:0.15"/>
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions>
                                                        <StopStoryboard BeginStoryboardName="FlashAnim"/>
                                                    </DataTrigger.ExitActions>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Rectangle.Style>
                                </Rectangle>
                            </Grid>
                            <TextBlock Text="{Binding MoodText}" FontSize="18" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,20,0,0" FontFamily="Consolas"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Grid>
        </Border>

        <!-- 소리 설정 및 투명도 슬라이더 -->
        <Button HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,-15,0" Width="40" Height="40" Click="MuteButton_Click" ToolTip="{u:T idle.btn.sound}" Cursor="Hand">
            <Button.Style>
                <Style TargetType="Button">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bg" Background="#E8F5E9" BorderBrush="#4CAF50" BorderThickness="2" CornerRadius="20">
                                    <Image x:Name="icon" Source="/TamaPoke;component/Assets/UI/icon_sound_on.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bg" Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsMuted}" Value="True">
                                        <Setter TargetName="bg" Property="Background" Value="#FFEBEE"/>
                                        <Setter TargetName="bg" Property="BorderBrush" Value="#E53935"/>
                                        <Setter TargetName="icon" Property="Source" Value="/TamaPoke;component/Assets/UI/icon_sound_off.png"/>
                                    </DataTrigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Button.Style>
        </Button>
        <!-- 투명도 조절: 몬스터볼 빨간 띠의 가운데(반지름 150)를 따라 움직이는 원호 슬라이더. 위쪽 끝 = 불투명, 아래쪽 끝 = 가장 투명
             (원호 모양/위치는 IdleView.xaml.cs에서 계산합니다) -->
        <Canvas Width="320" Height="320" HorizontalAlignment="Left" VerticalAlignment="Top" ToolTip="{u:T idle.btn.stealth}">
            <Path x:Name="OpacityTrack" Stroke="#55FFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
            <Path x:Name="OpacityFill" Stroke="#EEFFFFFF" StrokeThickness="4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" IsHitTestVisible="False"/>
            <Path x:Name="OpacityHitArea" Stroke="Transparent" StrokeThickness="16" Cursor="Hand"
                  MouseLeftButtonDown="OpacityArc_MouseDown" MouseMove="OpacityArc_MouseMove" MouseLeftButtonUp="OpacityArc_MouseUp"/>
            <Ellipse x:Name="OpacityThumb" Width="13" Height="13" Fill="#1E88E5" Stroke="White" StrokeThickness="2.5" Cursor="Hand"
                     MouseLeftButtonDown="OpacityArc_MouseDown" MouseMove="OpacityArc_MouseMove" MouseLeftButtonUp="OpacityArc_MouseUp">
                <Ellipse.Effect>
                    <DropShadowEffect BlurRadius="3" ShadowDepth="1" Opacity="0.4"/>
                </Ellipse.Effect>
            </Ellipse>
        </Canvas>
    </Grid>
</UserControl>