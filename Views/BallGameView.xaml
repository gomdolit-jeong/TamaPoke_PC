<UserControl x:Class="TamaPoke.Views.BallGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             Height="320" Width="350"
             MouseMove="GameArea_MouseMove"
             RenderOptions.BitmapScalingMode="NearestNeighbor">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 픽셀 버튼 (대기 화면과 같은 스타일) -->
                <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 바깥쪽 배경 투명 처리로 네 모서리 동그랗게 유지 -->
    <Grid Background="Transparent">
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E53935" Offset="0.0" />
                    <GradientStop Color="#E53935" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                <Grid.Clip>
                    <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                </Grid.Clip>

                <!-- 배경 분할 (주간 고정 색상 적용) -->
                <Grid.RowDefinitions>
                    <RowDefinition Height="45*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="35*"/>
                </Grid.RowDefinitions>

                <!-- 픽셀 배경 (96x96 → 3배) -->
                <Image Grid.RowSpan="3" Source="/TamaPoke;component/Assets/UI/bg_game_ball.png" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <!-- 포켓몬 및 UI -->
                <Grid Grid.RowSpan="3">
                    <Image Source="{Binding CurrentFrame}" Width="90" Height="90" Margin="0,15,0,0" 
                           RenderOptions.BitmapScalingMode="NearestNeighbor" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5"
                           Cursor="Hand" MouseLeftButtonDown="TapBall_Click">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding FlipX}" ScaleY="1"/>
                                <TranslateTransform X="{Binding PosX}" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- 점수 표시 -->
                    <TextBlock Text="{Binding GameScore}" FontSize="40" FontWeight="Bold" Foreground="#AA000000" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Border Style="{StaticResource PixelTag}" Background="#F6F3EA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,90,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HI:" FontSize="11" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding GameHighScore}" FontSize="11" FontWeight="Bold" Foreground="#333333"/>
                        </StackPanel>
                    </Border>

                    <!-- 공 캔버스 (즉발형 터치를 위한 PreviewMouseLeftButtonDown 유지) -->
                    <Canvas Width="288" Height="288" ClipToBounds="True" IsHitTestVisible="False">
                        <!-- 공(Button)에 있던 PreviewMouseLeftButtonDown 이벤트를 삭제했습니다 -->
                        <Button Width="32" Height="32" Background="Transparent" BorderThickness="0">
                            <!-- ... (공 그리는 ControlTemplate 영역은 기존과 동일하게 유지) ... -->
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <!-- 픽셀 몬스터볼 (9x9 → 3배) -->
                                    <Image Source="/TamaPoke;component/Assets/UI/icon_ball.png" Width="27" Height="27" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </ControlTemplate>
                            </Button.Template>
                            <Canvas.Left>
                                <Binding Path="BallX"/>
                            </Canvas.Left>
                            <Canvas.Top>
                                <Binding Path="BallY"/>
                            </Canvas.Top>
                        </Button>
                    </Canvas>

                    <!-- 그만하기 버튼 -->
                    <Button Content="{u:T game.quit}" Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" Click="QuitGame_Click" Style="{StaticResource PixelTextButton}" Background="#757575"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>