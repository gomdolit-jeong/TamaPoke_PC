<UserControl x:Class="TamaPoke.Views.InventoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lc="clr-namespace:TamaPoke.Converters"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             Width="288" Height="288">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 픽셀 버튼/상자 (대기 화면, 배틀 화면과 같은 스타일) -->
                <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!-- 목록 한 줄: 픽셀 칸, 마우스를 올리면 살짝 밝게 -->
            <Style TargetType="ContentControl" x:Key="BagRow" BasedOn="{StaticResource PixelTile}">
                <Setter Property="Height" Value="30"/>
                <Setter Property="Margin" Value="0,0,6,4"/>
                <Setter Property="Padding" Value="6,0,8,2"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#FFFBEA"/>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 위쪽 탭 (가방 / 메가스톤): 고른 쪽은 밝게, 아닌 쪽은 어둡게 (ShowTab에서 바꿈) -->
            <Style TargetType="ContentControl" x:Key="BagTab" BasedOn="{StaticResource PixelTile}">
                <Setter Property="Height" Value="28"/>
                <Setter Property="Padding" Value="8,0,10,2"/>
                <Setter Property="Margin" Value="3,0"/>
                <Setter Property="Cursor" Value="Hand"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#F2202436" Padding="25,40,25,26">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- 탭: 아이템 / 메가스톤 -->
                <RowDefinition Height="*"/>
                <!-- 목록 -->
                <RowDefinition Height="Auto"/>
                <!-- 닫기 버튼 -->
            </Grid.RowDefinitions>

            <!-- 상단 탭: 누른 쪽 목록을 보여줍니다. -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,8">
                <ContentControl x:Name="ItemsTabTile" Style="{StaticResource BagTab}" MouseLeftButtonDown="ItemsTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_bag.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ItemsTab" Text="{u:T bag.title}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ContentControl>
                <ContentControl x:Name="MegaTabTile" Style="{StaticResource BagTab}" MouseLeftButtonDown="MegaTab_Click">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_mega.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock x:Name="MegaTab" Text="{u:T bag.mega.title}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                </ContentControl>
            </StackPanel>

            <!-- 🌟 동적으로 아이템을 렌더링하는 ItemsControl (스크롤 지원) -->
            <ScrollViewer x:Name="ItemsPanel" Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Inventory}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <ContentControl Style="{StaticResource BagRow}" Cursor="Hand" MouseLeftButtonDown="UseItem_Click" ToolTip="{Binding Description}">
                                <Grid>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                        <Image Source="{Binding IconImage}" Style="{StaticResource PixelIcon}" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" Foreground="#333" FontSize="13" FontWeight="Bold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Quantity, StringFormat='x {0}'}" Foreground="#333" FontSize="13" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                            </ContentControl>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 메가스톤: 메가링 상태와 완성한 스톤 / 모으는 중인 조각 -->
            <DockPanel x:Name="MegaPanel" Grid.Row="1" Visibility="Collapsed">
                <TextBlock DockPanel.Dock="Top" Text="{Binding MegaRingText}" Foreground="#CCFFFFFF" FontSize="11" TextWrapping="Wrap" TextAlignment="Center" Margin="10,0,10,6"/>
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding MegaStoneRows}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl x:Name="Row" Style="{StaticResource BagRow}" Height="28">
                                    <Grid>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,0,44,0">
                                            <Image Source="/TamaPoke;component/Assets/UI/icon_mega.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                                            <TextBlock x:Name="StoneName" Text="{Binding Name}" Foreground="#333" FontSize="12" FontWeight="Bold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        </StackPanel>
                                        <TextBlock x:Name="StoneProgress" Text="{Binding Progress}" Foreground="#6E6A5E" FontSize="12" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </ContentControl>
                                <DataTemplate.Triggers>
                                    <!-- 완성한 스톤: 금빛 칸 -->
                                    <DataTrigger Binding="{Binding IsComplete}" Value="True">
                                        <Setter TargetName="Row" Property="Background" Value="#FFE9A8"/>
                                        <Setter TargetName="StoneName" Property="Foreground" Value="#7A5200"/>
                                        <Setter TargetName="StoneProgress" Property="Foreground" Value="#7A5200"/>
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>

            <!-- 닫기 버튼 -->
            <Button Grid.Row="2" Content="{u:T common.close}" Style="{StaticResource PixelTextButton}" Background="#E53935"
                    Height="34" Margin="50,10,50,0" FontSize="14" Click="CloseButton_Click"/>
        </Grid>
    </Border>
</UserControl>
