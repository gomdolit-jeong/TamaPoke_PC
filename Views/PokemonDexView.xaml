<UserControl x:Class="TamaPoke.Views.PokemonDexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TamaPoke.Views"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             mc:Ignorable="d" 
             Background="Transparent">
    <!-- 🌟 바탕을 투명하게 변경하여 동그라미만 보이게 합니다 -->

    <UserControl.Resources>

        <!-- 지방 탭 라디오 버튼 스타일 (기존 유지) -->
        <!-- 🌟 수정됨: 지방 탭 라디오 버튼 스타일 (내부 구조를 자유롭게 구성할 수 있도록 변경) -->
        <Style TargetType="RadioButton" x:Key="RegionTabStyle">
            <Setter Property="Foreground" Value="#555555"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- TextElement.Foreground를 추가하여 내부 글자색이 자동으로 하얀색/회색으로 변하게 합니다 -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="6" Padding="6,4" Margin="1,0" Cursor="Hand" TextElement.Foreground="{TemplateBinding Foreground}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 하단 닫기 버튼 전용 스타일 (기존 유지) -->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="12" Padding="20,6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!-- 🌟 다른 창들처럼 동일한 크기의 동그란 테두리 적용 -->
    <Border Background="#F8F9FA" CornerRadius="144" Width="288" Height="288" BorderBrush="Black" BorderThickness="1.5">

        <!-- 원형 밖으로 내용이 삐져나가지 않도록 상하좌우 마진을 줍니다 -->
        <Grid Margin="30,20,35,5">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <!-- 🌟 체크박스가 들어갈 세 번째 줄 추가 -->
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 헤더 영역 -->
            <TextBlock Grid.Row="0" Text="포켓몬 도감" Foreground="#E53935" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" Margin="0,0,0,5"/>

            <!-- 2. 지방(Region) 선택 탭 메뉴 (1~9세대 전체 확장 및 스크롤 적용) -->
            <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Margin="5,0,5,5">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" IsChecked="True" Tag="0" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="관동" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding KantoCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="1" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="성도" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding JohtoCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="2" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="호연" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding HoennCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="3" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="신오" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding SinnohCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="4" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="하나" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding UnovaCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="5" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="칼로스" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding KalosCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="6" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="알로라" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding AlolaCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="7" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="가라르" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding GalarCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>

                    <RadioButton GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="8" Checked="RegionTab_Checked">
                        <StackPanel>
                            <TextBlock Text="팔데아" FontWeight="Bold" FontSize="10" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding PaldeaCountText}" FontWeight="Normal" FontSize="8" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                        </StackPanel>
                    </RadioButton>
                </StackPanel>
            </ScrollViewer>

            <!-- 🌟 2-5. 새로 추가됨: 잡은 포켓몬만 보기 체크박스 -->
            <CheckBox Grid.Row="2" Content="잡은 포켓몬" IsChecked="{Binding IsShowOnlyUnlocked}" 
                      HorizontalAlignment="Right" Margin="0,0,10,0" 
                      Foreground="#666666" FontSize="10" FontWeight="Bold" Cursor="Hand"/>

            <!-- 3. 포켓몬 도감 리스트 갤러리 (Row를 2에서 3으로 변경) -->
            <ScrollViewer x:Name="DexScrollViewer" Grid.Row="3" VerticalScrollBarVisibility="Auto" Margin="6,0,6,0">
                <ItemsControl ItemsSource="{Binding FilteredPokedex}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Width="85" Height="90" Margin="3" Background="White" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1">
                                <StackPanel VerticalAlignment="Center">
                                    <Image Source="{Binding SpriteImage}" Margin="0,0,0,-5" Width="55" Height="55" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor">
                                    <Image.Style>
                                            <Style TargetType="Image">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                        <Setter Property="Opacity" Value="0.2"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Image.Style>
                                    </Image>
                                    <TextBlock Text="{Binding Id, StringFormat='No.{0:D4}'}" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 4. 하단 닫기 버튼 영역 -->
            <Button Grid.Row="4" Content="닫기" Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Center" Margin="0,10,0,0" Click="DexButton_Click"/>
        </Grid>
    </Border>
</UserControl>