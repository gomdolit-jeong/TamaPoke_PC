<UserControl x:Class="TamaPoke.Views.PokemonDexView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TamaPoke.Views"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="466" d:DesignWidth="466"
             Background="#F8F9FA">

    <UserControl.Resources>
        <conv:IdToImageConverter x:Key="IdToImage"/>

        <!-- 지방 탭 라디오 버튼 스타일 -->
        <Style TargetType="RadioButton" x:Key="RegionTabStyle">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <!-- 🌟 버튼 간격 마진 1 유지 -->
                        <Border Background="{TemplateBinding Background}" BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Padding="10,6" Margin="1" Cursor="Hand">
                            <TextBlock Text="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}" FontWeight="Bold" FontSize="12" HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter Property="Background" Value="#E53935"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="False">
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Setter Property="Foreground" Value="#555555"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 하단 닫기 버튼 전용 스타일 -->
        <Style TargetType="Button" x:Key="CloseButtonStyle">
            <Setter Property="Background" Value="#E53935"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="18" Padding="30,8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#D32F2F"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="50"/>
        </Grid.RowDefinitions>

        <!-- 1. 헤더 영역 -->
        <Border Grid.Row="0" Background="#E53935">
            <TextBlock Text="포켓몬 도감" Foreground="White" FontWeight="Bold" FontSize="18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>

        <!-- 2. 지방(Region) 선택 탭 메뉴 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <RadioButton Content="관동" GroupName="Region" Style="{StaticResource RegionTabStyle}" IsChecked="True" Tag="0" Checked="RegionTab_Checked"/>
            <RadioButton Content="성도" GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="1" Checked="RegionTab_Checked"/>
            <RadioButton Content="호연" GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="2" Checked="RegionTab_Checked"/>
            <RadioButton Content="신오" GroupName="Region" Style="{StaticResource RegionTabStyle}" Tag="3" Checked="RegionTab_Checked"/>
        </StackPanel>

        <!-- 3. 포켓몬 도감 리스트 갤러리 -->
        <ScrollViewer x:Name="DexScrollViewer" Grid.Row="2" VerticalScrollBarVisibility="Auto" Margin="10,0,10,0">
            <ItemsControl ItemsSource="{Binding FilteredPokedex}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel HorizontalAlignment="Center"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 🌟 카드 높이를 105에서 90으로 줄여 타이트하게 만들었습니다 -->
                        <Border Width="85" Height="90" Margin="5" Background="White" CornerRadius="8" BorderBrush="#DDDDDD" BorderThickness="1">
                            <StackPanel VerticalAlignment="Center">
                                <!-- 🌟 아래쪽 마진을 -5로 당겨서 숫자 텍스트와 바짝 붙입니다 -->
                                <Image Source="{Binding Id, Converter={StaticResource IdToImage}}" Margin="0,0,0,-5" Width="55" Height="55" Stretch="Uniform">
                                    <Image.Style>
                                        <Style TargetType="Image">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsUnlocked}" Value="False">
                                                    <Setter Property="Opacity" Value="0.2"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Image.Style>
                                </Image>

                                <TextBlock Text="{Binding Id, StringFormat='No.{0:D3}'}" FontSize="10" Foreground="#888888" HorizontalAlignment="Center" Margin="0,0,0,0"/>
                                <TextBlock Text="{Binding DisplayName}" FontSize="12" FontWeight="Bold" Foreground="#333333" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 4. 하단 닫기 버튼 영역 -->
        <Border Grid.Row="3" Background="#F8F9FA">
            <Button Content="닫기" Style="{StaticResource CloseButtonStyle}" HorizontalAlignment="Center" VerticalAlignment="Center" Click="DexButton_Click"/>
        </Border>
    </Grid>
</UserControl>