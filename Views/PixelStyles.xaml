<!-- 픽셀 UI 공통 스타일 (대기 화면, 배틀 화면에서 함께 사용)
     그림 한 칸 = 2 DIP (포켓몬과 같은 배율). 버튼/아이콘 그림은 Assets/UI 에 있음 (실행 파일에 포함) -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- 동그란 픽셀 버튼: 진한 외곽선 + 아래쪽 그늘 + 그림자. 누르면 한 칸 내려가며 그림자를 덮음 -->
    <Style TargetType="Button" x:Key="PhysicalButton">
        <Setter Property="Width" Value="32"/>
        <Setter Property="Height" Value="32"/>
        <Setter Property="Margin" Value="4,4"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Image x:Name="Shadow" Source="/TamaPoke;component/Assets/UI/btn_shadow.png" Width="30" Height="30" Margin="2,2,0,0"
                               HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        <Grid x:Name="Face" Width="30" Height="30" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Image x:Name="FaceImage" Source="/TamaPoke;component/Assets/UI/btn_face.png" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="FaceImage" Property="Source" Value="/TamaPoke;component/Assets/UI/btn_face_hover.png"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="Margin" Value="2,2,0,0"/>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 버튼 안의 9x9 픽셀 아이콘 -->
    <Style TargetType="Image" x:Key="PixelIcon">
        <Setter Property="Width" Value="18"/>
        <Setter Property="Height" Value="18"/>
        <Setter Property="RenderOptions.BitmapScalingMode" Value="NearestNeighbor"/>
    </Style>

    <!-- 픽셀 상자: 진한 테두리 + 모서리 한 칸 깎기 + 위 하이라이트/아래 그늘 + 그림자 -->
    <Style TargetType="ContentControl" x:Key="PixelPanel">
        <Setter Property="Padding" Value="8,5"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid SnapsToDevicePixels="True">
                        <Grid Opacity="0.27" Margin="2,2,-2,-2">
                            <Rectangle Fill="Black" Margin="2,0"/>
                            <Rectangle Fill="Black" Margin="0,2"/>
                        </Grid>
                        <Rectangle Fill="#3B3B4A" Margin="2,0"/>
                        <Rectangle Fill="#3B3B4A" Margin="0,2"/>
                        <Rectangle Fill="#F6F3EA" Margin="2"/>
                        <Rectangle Fill="#FFFFFF" Margin="4,2,4,0" Height="2" VerticalAlignment="Top"/>
                        <Rectangle Fill="#DED8C8" Margin="4,0,4,2" Height="2" VerticalAlignment="Bottom"/>
                        <ContentPresenter Margin="{TemplateBinding Padding}"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 픽셀 상태 바 (포켓몬 HP 바 느낌): 진한 테두리 + 위 밝은 줄/아래 어두운 줄 -->
    <Style TargetType="ProgressBar" x:Key="PixelBar">
        <Setter Property="Height" Value="10"/>
        <Setter Property="Margin" Value="0,2"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border Background="#3B3B4A" Padding="2" SnapsToDevicePixels="True">
                        <Grid x:Name="PART_Track" Background="#D9D5C8">
                            <Grid x:Name="PART_Indicator" HorizontalAlignment="Left">
                                <Rectangle Fill="{TemplateBinding Foreground}"/>
                                <Rectangle Fill="#66FFFFFF" Height="2" VerticalAlignment="Top"/>
                                <Rectangle Fill="#33000000" Height="2" VerticalAlignment="Bottom"/>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 픽셀 상자 안의 글자 (낮/밤 상관없이 진한 색) -->
    <Style TargetType="TextBlock" x:Key="PanelLabel">
        <Setter Property="Foreground" Value="#3B3B4A"/>
        <Setter Property="FontSize" Value="10"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
    </Style>

    <!-- 글자 픽셀 버튼: 진한 외곽선 + 모서리 한 칸 깎기 + 위 하이라이트/아래 그늘 + 그림자. Background가 버튼 면 색 -->
    <Style TargetType="Button" x:Key="PixelTextButton">
        <Setter Property="Background" Value="#9E9E9E"/>
        <Setter Property="Padding" Value="6,0,6,1"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid SnapsToDevicePixels="True">
                        <Grid x:Name="Shadow" Opacity="0.3" Margin="2,2,-2,-2">
                            <Rectangle Fill="Black" Margin="2,0"/>
                            <Rectangle Fill="Black" Margin="0,2"/>
                        </Grid>
                        <Grid x:Name="Face">
                            <Rectangle Fill="#2B2B36" Margin="2,0"/>
                            <Rectangle Fill="#2B2B36" Margin="0,2"/>
                            <Rectangle Fill="{TemplateBinding Background}" Margin="2"/>
                            <Rectangle Fill="#59FFFFFF" Margin="4,2,4,0" Height="2" VerticalAlignment="Top"/>
                            <Rectangle Fill="#38000000" Margin="2,0,2,2" Height="3" VerticalAlignment="Bottom"/>
                            <Rectangle x:Name="Hover" Fill="#26FFFFFF" Margin="2" Visibility="Collapsed"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Hover" Property="Visibility" Value="Visible"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Face" Property="RenderTransform">
                                <Setter.Value>
                                    <TranslateTransform X="2" Y="2"/>
                                </Setter.Value>
                            </Setter>
                            <Setter TargetName="Shadow" Property="Visibility" Value="Hidden"/>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 밝은 글자 픽셀 버튼 (기술/아이템 고르기 등) -->
    <Style TargetType="Button" x:Key="PixelLightButton" BasedOn="{StaticResource PixelTextButton}">
        <Setter Property="Background" Value="#F6F3EA"/>
        <Setter Property="Foreground" Value="#333333"/>
    </Style>
</ResourceDictionary>
