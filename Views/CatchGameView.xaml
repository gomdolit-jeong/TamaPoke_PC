<UserControl x:Class="TamaPoke.Views.CatchGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Height="320" Width="350"
             MouseMove="GameArea_MouseMove"
             RenderOptions.BitmapScalingMode="NearestNeighbor">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 픽셀 버튼 (대기 화면과 같은 스타일) -->
                <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4DD0E1" Offset="0.0" />
                    <GradientStop Color="#00BCD4" Offset="0.48" />
                    <GradientStop Color="#00838F" Offset="0.48" />
                    <GradientStop Color="#006064" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                <Grid.Clip>
                    <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                </Grid.Clip>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="35*"/>
                </Grid.RowDefinitions>

                <!-- 픽셀 배경 (96x96 → 3배) -->
                <Image Grid.RowSpan="3" Source="/TamaPoke;component/Assets/UI/bg_game_catch.png" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <Grid Grid.RowSpan="3">

                    <!-- 타이머 및 점수 -->
                    <TextBlock Text="{Binding CatchTimeLeft, StringFormat={}{0:F1}s}" FontSize="36" FontWeight="Bold" Foreground="#AA000000" HorizontalAlignment="Center" Margin="0,35,0,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <TextBlock Text="{Binding CatchScore}" FontSize="24" FontWeight="Bold" Foreground="#AA000000" HorizontalAlignment="Right" Margin="0,45,40,0">
                        <TextBlock.Effect>
                            <DropShadowEffect Color="White" BlurRadius="6" ShadowDepth="0" Opacity="1"/>
                        </TextBlock.Effect>
                    </TextBlock>
                    <Border Style="{StaticResource PixelTag}" Background="#F6F3EA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,85,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HI:" FontSize="11" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding CatchHighScore}" FontSize="11" FontWeight="Bold" Foreground="#333333"/>
                        </StackPanel>
                    </Border>

                    <!-- 포켓몬 이미지 -->
                    <Image Source="{Binding CurrentFrame}" Width="90" Height="90" Margin="0,15,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding FlipX}" ScaleY="1"/>
                                <TranslateTransform X="{Binding PosX}" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- 과일 낙하 캔버스 -->
                    <Canvas Width="288" Height="288" ClipToBounds="True">
                        <!-- 픽셀 과일 (9x9 → 3배) -->
                        <Image Source="{Binding CurrentFruitImage}" Width="27" Height="27" RenderOptions.BitmapScalingMode="NearestNeighbor" Canvas.Left="{Binding FruitX}" Canvas.Top="{Binding FruitY}"/>
                    </Canvas>

                    <Button Content="{u:T game.quit}" Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" Click="QuitGame_Click" Style="{StaticResource PixelTextButton}" Background="#757575"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>