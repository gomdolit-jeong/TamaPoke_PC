<UserControl x:Class="TamaPoke.Views.CatchGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Height="320" Width="350"
             MouseMove="GameArea_MouseMove"
             RenderOptions.BitmapScalingMode="NearestNeighbor"
             RenderOptions.EdgeMode="Aliased">

    <Grid Background="Transparent">
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#4DD0E1" Offset="0.0" />
                    <GradientStop Color="#00BCD4" Offset="0.48" />
                    <GradientStop Color="#00838F" Offset="0.48" />
                    <GradientStop Color="#006064" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center" Background="Transparent">
                <Grid.Clip>
                    <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                </Grid.Clip>

                <Grid.RowDefinitions>
                    <RowDefinition Height="45*"/>
                    <RowDefinition Height="20*"/>
                    <RowDefinition Height="35*"/>
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="#81D4FA"/>
                <Border Grid.Row="1" Background="#A5D6A7"/>
                <Border Grid.Row="2" Background="#795548"/>

                <Grid Grid.RowSpan="3">

                    <!-- 타이머 및 점수 -->
                    <TextBlock Text="{Binding CatchTimeLeft, StringFormat={}{0:F1}s}" FontSize="36" FontWeight="Bold" Foreground="#88000000" HorizontalAlignment="Center" Margin="0,35,0,0"/>
                    <TextBlock Text="{Binding CatchScore}" FontSize="24" FontWeight="Bold" Foreground="#88000000" HorizontalAlignment="Right" Margin="0,45,40,0"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,85,0,0">
                        <TextBlock Text="HI:" FontSize="12" FontWeight="Bold" Foreground="#555555" Margin="0,0,5,0"/>
                        <TextBlock Text="{Binding CatchHighScore}" FontSize="12" FontWeight="Bold" Foreground="#555555"/>
                    </StackPanel>

                    <!-- 포켓몬 이미지 -->
                    <Image Source="{Binding CurrentFrame}" Width="90" Height="90" Margin="0,15,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <Image.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform ScaleX="{Binding FlipX}" ScaleY="1"/>
                                <TranslateTransform X="{Binding PosX}" Y="0"/>
                            </TransformGroup>
                        </Image.RenderTransform>
                    </Image>

                    <!-- 과일 낙하 캔버스 -->
                    <Canvas Width="288" Height="288" ClipToBounds="True">
                        <emoji:TextBlock Text="{Binding CurrentFruitIcon}" FontSize="28" Canvas.Left="{Binding FruitX}" Canvas.Top="{Binding FruitY}"/>
                    </Canvas>

                    <Button Content="그만하기" Width="70" Height="22" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" Click="QuitGame_Click" Background="#757575" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="4"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>