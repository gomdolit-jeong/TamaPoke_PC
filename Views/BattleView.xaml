<UserControl x:Class="TamaPoke.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             Height="288" Width="288"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>

        <!-- 🌟 스킬 타입에 색상을 입혀줄 변환기 등록 -->
        <conv:TypeToColorConverter x:Key="TypeToColor"/>

        <!-- 공통 버튼 스타일 (메인 메뉴 및 승리 팝업용) -->
        <Style TargetType="Button" x:Key="RoundedButtonStyle">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="10" Padding="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.8"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="RenderTransform">
                                    <Setter.Value>
                                        <TranslateTransform X="1" Y="1"/>
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F2EFE1" ClipToBounds="True">
        <Grid.Clip>
            <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
        </Grid.Clip>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- 1. 상단 배틀 화면 영역 (적 / 플레이어 정보) -->
        <!-- ========================================== -->
        <Grid Grid.Row="0">
            <!-- 적 포켓몬 정보창 -->
            <Border Margin="60,25,0,0" Background="#FAFAFA" CornerRadius="8" Padding="8,4" BorderBrush="#555" BorderThickness="2" HorizontalAlignment="Left" VerticalAlignment="Top" Width="120">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding EnemyName}" FontSize="12" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding EnemyLevel, StringFormat={} Lv.{0}}" FontSize="11" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding EnemyHp}" Maximum="{Binding EnemyMaxHp}" Height="8" Margin="0,4,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{Binding EnemyHpColor}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#888"/>
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnemyTakingDamage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="EnemyBlinkAnim">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="EnemyBlinkAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Border>

            <!-- 적 포켓몬 이미지 -->
            <Image Source="{Binding EnemyCurrentFrame}" Visibility="{Binding IsEnemyVisible, Converter={StaticResource BoolToVis}}" Width="72" Height="72" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,35,30,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <!-- 내 포켓몬 이미지 -->
            <Image Source="{Binding CurrentFrame}" Width="72" Height="72" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="40,0,0,10" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Image.RenderTransform>
                    <ScaleTransform ScaleX="-1" ScaleY="1" CenterX="36" CenterY="36"/>
                </Image.RenderTransform>
            </Image>

            <!-- 몬스터볼 이펙트 애니메이션 객체 -->
            <Grid x:Name="PokeballIcon" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,40" Visibility="Collapsed" Panel.ZIndex="10">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PokeballRotate" Angle="0" CenterX="12" CenterY="12"/>
                        <TranslateTransform x:Name="PokeballTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Path Fill="#E53935" Data="M 0,12 A 12,12 0 0 1 24,12 Z"/>
                <Path Fill="White" Data="M 0,12 A 12,12 0 0 0 24,12 Z"/>
                <Ellipse Stroke="#333" StrokeThickness="2"/>
                <Rectangle Height="2" Fill="#333" VerticalAlignment="Center"/>
                <Ellipse Width="8" Height="8" Fill="White" Stroke="#333" StrokeThickness="2" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Grid>

            <!-- 플레이어 포켓몬 정보창 -->
            <Border Margin="0,0,50,5" Background="#FAFAFA" CornerRadius="8" Padding="8,4" BorderBrush="#555" BorderThickness="2" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="120">
                <StackPanel>
                    <Grid>
                        <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding Level, StringFormat={} Lv.{0}}" FontSize="11" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right"/>
                    </Grid>
                    <ProgressBar Value="{Binding PlayerHp}" Maximum="{Binding PlayerMaxHp}" Height="8" Margin="0,4,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar">
                                <Setter Property="Foreground" Value="{Binding PlayerHpColor}"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="BorderBrush" Value="#888"/>
                                <Setter Property="Background" Value="#E0E0E0"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayerTakingDamage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="PlayerBlinkAnim">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PlayerBlinkAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#333" Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="PlayerHp"/>
                                <Binding Path="PlayerMaxHp"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 2. 중앙 팝업: 승리 시 포획 / 도망 선택 창 -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsCatchOffered, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <Border Background="#FAFAFA" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#333" BorderThickness="3">
                <StackPanel>
                    <TextBlock Text="배틀에서 승리했다!" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="포획하기" Width="90" Height="35" Margin="0,0,10,0" Background="#E53935" Style="{StaticResource RoundedButtonStyle}" Click="Catch_Click"/>
                        <Button Content="그냥가기" Width="90" Height="35" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="Leave_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 🌟 스킬 학습 창 (추천 스킬 2개) -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsSkillLearnMenuOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="110">
            <Border Background="#FAFAFA" CornerRadius="15" Padding="15" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#333" BorderThickness="3">
                <StackPanel>
                    <TextBlock Text="새로운 스킬을 떠올렸다!" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>

                    <!-- 🌟 가로(좌우) 배치를 위한 StackPanel 추가 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">

                        <!-- 추천 스킬 1 버튼 (크기 축소: Width 100) -->
                        <Button Visibility="{Binding HasRecommendedSkill1, Converter={StaticResource BoolToVis}}" 
                                Width="100" Height="45" Margin="4,0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnLearnSkill1_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendedSkill1.Name}" FontWeight="Bold" FontSize="11" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding RecommendedSkill1.Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RecommendedSkill1.Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                        <!-- 추천 스킬 2 버튼 (크기 축소: Width 100) -->
                        <Button Visibility="{Binding HasRecommendedSkill2, Converter={StaticResource BoolToVis}}" 
                                Width="100" Height="45" Margin="4,0" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnLearnSkill2_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendedSkill2.Name}" FontWeight="Bold" FontSize="11" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding RecommendedSkill2.Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RecommendedSkill2.Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>

                    </StackPanel>

                    <!-- 하단 취소 버튼 (위의 버튼 2개 넓이에 맞춰 안정감 있게 변경) -->
                    <Button Content="배우지 않는다" Width="208" Height="30" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="BtnSkipSkill_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 🌟 스킬 교체 창 (기존 스킬 잊기) -->
        <!-- ========================================== -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsSkillReplaceMenuOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="110">
            <Border Background="#FAFAFA" CornerRadius="15" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#333" BorderThickness="3">
                <StackPanel>
                    <TextBlock Text="스킬 4개가 꽉 찼습니다.&#x0a;어떤 스킬을 지우시겠습니까?" TextAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                        <!-- 잊기 슬롯 0 -->
                        <Button Margin="3" Height="45" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnReplaceSkill0_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[0].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding CurrentSkills[0].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[0].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- 잊기 슬롯 1 -->
                        <Button Margin="3" Height="45" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnReplaceSkill1_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[1].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding CurrentSkills[1].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[1].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- 잊기 슬롯 2 -->
                        <Button Margin="3" Height="45" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnReplaceSkill2_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[2].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding CurrentSkills[2].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[2].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <!-- 잊기 슬롯 3 -->
                        <Button Margin="3" Height="45" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="BtnReplaceSkill3_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[3].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="3" Background="{Binding CurrentSkills[3].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[3].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Button Content="역시 배우지 않는다" Width="150" Height="30" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="BtnSkipSkill_Click"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- ========================================== -->
        <!-- 3. 하단 컨트롤 영역 (메뉴 / 스킬 / 가방 전환) -->
        <!-- ========================================== -->
        <Grid Grid.Row="1" Background="#333333">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="65"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="{Binding BattleMessage}" Foreground="White" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Margin="10,5,10,5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

            <Grid Grid.Row="1">
                <UniformGrid HorizontalAlignment="Center" Columns="2" Margin="0,0,0,10" Rows="2" 
                             Visibility="{Binding IsMainMenuVisible, Converter={StaticResource BoolToVis}}">
                    <Button Content="공격" Width="55" Height="24" Margin="3" Background="#E53935" Style="{StaticResource RoundedButtonStyle}" Click="ShowAttackMenu_Click"/>
                    <Button Content="회피" Width="55" Height="24" Margin="3" Background="#1E88E5" Style="{StaticResource RoundedButtonStyle}" Click="Dodge_Click"/>
                    <Button Content="가방" Width="55" Height="24" Margin="3" Background="#FFB300" Style="{StaticResource RoundedButtonStyle}" Click="OpenInventory_Click"/>
                    <Button Content="도망" Width="55" Height="24" Margin="3" Background="#757575" Style="{StaticResource RoundedButtonStyle}" Click="Run_Click"/>
                </UniformGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Background="#333333" 
                            Visibility="{Binding IsAttackMenuOpen, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding CurrentSkills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="100" Height="26" Margin="4" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="SkillButton_Click">
                                    <Button.Resources>
                                        <Style TargetType="Border">
                                            <Setter Property="CornerRadius" Value="4"/>
                                        </Style>
                                    </Button.Resources>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,5,0"/>

                                        <!-- 🌟 배경색을 컨버터로 예쁘게 바인딩합니다! -->
                                        <Border CornerRadius="3" Background="{Binding Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1">
                                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>

                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="◀" Width="45" Height="22" Margin="0,8,0,0" Background="#E0D8C8" Foreground="#333" FontWeight="Bold" Cursor="Hand" Click="CancelAttack_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="11"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Background="#333333" 
                        Visibility="{Binding IsBattleInventoryOpen, Converter={StaticResource BoolToVis}}">
                    <UniformGrid Columns="2" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,10">
                        <Button Width="85" Height="26" Margin="4" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="UseMonsterBall_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="몬스터볼 " FontWeight="Bold" FontSize="11" Foreground="#333"/>
                                <TextBlock Text="{Binding MonsterBalls, StringFormat={}x{0}}" FontSize="11" Foreground="#1E88E5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                        <Button Width="85" Height="26" Margin="4" Background="#FAFAFA" BorderBrush="#CCCCCC" BorderThickness="1" Cursor="Hand" Click="UsePotion_Click">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="4"/>
                                </Style>
                            </Button.Resources>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="상처약 " FontWeight="Bold" FontSize="11" Foreground="#333"/>
                                <TextBlock Text="{Binding Potions, StringFormat={}x{0}}" FontSize="11" Foreground="#1E88E5" FontWeight="Bold"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Button Content="◀" Width="45" Height="22" Background="#E0D8C8" Foreground="#333" FontWeight="Bold" Cursor="Hand" Click="CloseInventory_Click">
                        <Button.Resources>
                            <Style TargetType="Border">
                                <Setter Property="CornerRadius" Value="11"/>
                            </Style>
                        </Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>

        <!-- 패배 시 눈앞이 깜깜해지는 페이드아웃 오버레이 -->
        <Grid Background="Black" Panel.ZIndex="999" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDefeatedFadeOut}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>
    </Grid>
</UserControl>