<UserControl x:Class="TamaPoke.Views.BattleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             Height="288" Width="288"
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 픽셀 버튼/상자/바 (대기 화면과 같은 스타일) -->
            <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:TypeToColorConverter x:Key="TypeToColor"/>
        <conv:AilmentStyleConverter x:Key="AilmentStyle"/>

        <!-- 상태이상 배지 공통 모양 -->
        <Style TargetType="Border" x:Key="AilmentPillBase">
            <Setter Property="CornerRadius" Value="2"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="3,0"/>
            <Setter Property="Margin" Value="0,0,4,0"/>
            <Setter Property="HorizontalAlignment" Value="Left"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- 걸리는 순간 배지 깜빡임 -->
        <Storyboard x:Key="AilmentFlashAnim">
            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.2" Duration="0:0:0.12" AutoReverse="True" RepeatBehavior="3x"/>
        </Storyboard>

        <Style TargetType="Border" x:Key="EnemyAilmentPill" BasedOn="{StaticResource AilmentPillBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsEnemyAilmentFlash}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource AilmentFlashAnim}"/></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="PlayerAilmentPill" BasedOn="{StaticResource AilmentPillBase}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPlayerAilmentFlash}" Value="True">
                    <DataTrigger.EnterActions><BeginStoryboard Storyboard="{StaticResource AilmentFlashAnim}"/></DataTrigger.EnterActions>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- 스프라이트 위 상태이상 이모지: 위아래로 살짝 둥실둥실 -->
        <Style TargetType="emoji:TextBlock" x:Key="AilmentFxStyle">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="RenderTransform">
                <Setter.Value><TranslateTransform Y="0"/></Setter.Value>
            </Setter>
            <Style.Triggers>
                <EventTrigger RoutedEvent="Loaded">
                    <BeginStoryboard>
                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="0" To="-5" Duration="0:0:0.6"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- 배틀 창의 글자 버튼: 픽셀 버튼 (Background가 버튼 색) -->
        <Style TargetType="Button" x:Key="RoundedButtonStyle" BasedOn="{StaticResource PixelTextButton}"/>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F2EFE1" ClipToBounds="True">
        <Grid.Clip>
            <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
        </Grid.Clip>

        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="115"/>
        </Grid.RowDefinitions>

        <!-- 1. 상단 배틀 화면 영역 -->
        <Grid x:Name="BattleArea" Grid.Row="0">
            <!-- 배경: 대기 화면과 같은 장소 그림(96x96)을 3배로. 위쪽 하늘을 36만큼 잘라 지평선이 상대 이름 상자 바로 아래에 오게 합니다. -->
            <Image Source="{Binding BackgroundImage}" Width="288" Height="288" Stretch="Fill" VerticalAlignment="Top" Margin="0,-36,0,0"
                   RenderOptions.BitmapScalingMode="NearestNeighbor" IsHitTestVisible="False"/>

            <!-- 발판: 적은 오른쪽 위, 내 포켓몬은 왼쪽 아래. 포켓몬의 발이 발판 중앙에 오도록 배치합니다. -->
            <Ellipse x:Name="EnemyPlatform" Width="96" Height="22" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="160,87,0,0" IsHitTestVisible="False" Fill="#40000000"/>
            <Ellipse x:Name="PlayerPlatform" Width="130" Height="28" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="15,154,0,0" IsHitTestVisible="False" Fill="#40000000"/>

            <ContentControl Style="{StaticResource PixelPanel}" Margin="56,25,0,0" Padding="8,5,8,6" HorizontalAlignment="Left" VerticalAlignment="Top" Width="128">
                <StackPanel>
                    <!-- 🌟 적 이름, 상태이상, 레벨 패널 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding EnemyName}" FontSize="12" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding EnemyLevel, StringFormat={} Lv.{0}}" FontSize="11" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource EnemyAilmentPill}"
                                Visibility="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Visibility}"
                                Background="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Bg}"
                                BorderBrush="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Border}">
                            <TextBlock Text="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Text}" FontSize="8" FontWeight="Bold"
                                       Foreground="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Fg}"/>
                        </Border>
                        <ProgressBar Value="{Binding EnemyHp}" Maximum="{Binding EnemyMaxHp}" Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource PixelBar}">
                                <Setter Property="Foreground" Value="{Binding EnemyHpColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEnemyTakingDamage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="EnemyBlinkAnim">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="EnemyBlinkAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    </Grid>
                </StackPanel>
            </ContentControl>

            <Image x:Name="EnemySprite" Source="{Binding EnemyCurrentFrame}" Visibility="{Binding IsEnemyVisible, Converter={StaticResource BoolToVis}}" Width="72" Height="72" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="178,54,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <emoji:TextBlock Style="{StaticResource AilmentFxStyle}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,49,43,0" Panel.ZIndex="5"
                             Text="{Binding EnemyAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Fx}"
                             Visibility="{Binding IsEnemyVisible, Converter={StaticResource BoolToVis}}"/>

            <!-- 💎 메가진화 연출: 메가링 반응(빛 + 무지개 고리) → 흰 섬광과 함께 메가 모습으로 -->
            <!-- 뒷모습은 이미지 칸보다 왼쪽에 그려지므로, 몸통 중심(64, 134)에 맞춰 체력 패널/메시지 창에 덜 가리게 합니다. -->
            <Grid Width="100" Height="100" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="14,84,0,0" IsHitTestVisible="False"
                  Visibility="{Binding IsMegaEvolving, Converter={StaticResource BoolToVis}}">
                <Ellipse>
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Color="#CCFFFFFF" Offset="0"/>
                            <GradientStop Color="#66FFD54F" Offset="0.5"/>
                            <GradientStop Color="#00FFFFFF" Offset="1"/>
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="MegaGlowAnim">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.35" AutoReverse="True"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="MegaGlowAnim"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
                <Ellipse Margin="10" StrokeThickness="5" RenderTransformOrigin="0.5,0.5">
                    <Ellipse.Stroke>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#FF5252" Offset="0"/>
                            <GradientStop Color="#FFD740" Offset="0.25"/>
                            <GradientStop Color="#69F0AE" Offset="0.5"/>
                            <GradientStop Color="#40C4FF" Offset="0.75"/>
                            <GradientStop Color="#E040FB" Offset="1"/>
                        </LinearGradientBrush>
                    </Ellipse.Stroke>
                    <Ellipse.RenderTransform>
                        <RotateTransform/>
                    </Ellipse.RenderTransform>
                    <Ellipse.Style>
                        <Style TargetType="Ellipse">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                                    <DataTrigger.EnterActions>
                                        <BeginStoryboard Name="MegaRingAnim">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </DataTrigger.EnterActions>
                                    <DataTrigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="MegaRingAnim"/>
                                    </DataTrigger.ExitActions>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Ellipse.Style>
                </Ellipse>
            </Grid>

            <!-- 🌟 플레이어 이미지: 뒷모습(오른쪽 위를 바라봄)을 1.5배로, 발이 메시지 창 경계에 오도록 (화면 앞쪽에 있는 느낌) -->
            <Image x:Name="PlayerSprite" Source="{Binding CurrentFrame}" Width="108" Height="108" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,105,0,0" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

            <emoji:TextBlock Style="{StaticResource AilmentFxStyle}" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="112,0,0,60" Panel.ZIndex="5"
                             Text="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Fx}"/>

            <!-- 메가진화 순간의 흰 섬광 (메가링 반응 연출이 끝날 때) -->
            <Rectangle Fill="White" Opacity="0" IsHitTestVisible="False" Panel.ZIndex="20">
                <Rectangle.Style>
                    <Style TargetType="Rectangle">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimationUsingKeyFrames Storyboard.TargetProperty="Opacity">
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:1.85"/>
                                                <LinearDoubleKeyFrame Value="0.9" KeyTime="0:0:2.0"/>
                                                <LinearDoubleKeyFrame Value="0" KeyTime="0:0:2.5"/>
                                            </DoubleAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Rectangle.Style>
            </Rectangle>

            <!-- 💎 메가진화 버튼: 내 턴 메인 메뉴가 보이고, 이번 배틀에서 아직 메가진화하지 않았을 때 -->
            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="30,84,0,0" Panel.ZIndex="15"
                  Visibility="{Binding IsMainMenuVisible, Converter={StaticResource BoolToVis}}">
                <Button Visibility="{Binding CanMegaEvolveNow, Converter={StaticResource BoolToVis}}" Click="MegaEvolve_Click"
                        Style="{StaticResource PixelTextButton}" Background="#8E44EC" FontSize="10" Height="24">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_mega.png" Style="{StaticResource PixelIcon}" Margin="-2,0,3,0"/>
                        <TextBlock Text="{u:T battle.ui.mega}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </Grid>

            <Grid x:Name="PokeballIcon" Width="24" Height="24" HorizontalAlignment="Left" VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="10">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <RotateTransform x:Name="PokeballRotate" Angle="0" CenterX="12" CenterY="12"/>
                        <TranslateTransform x:Name="PokeballTranslate" X="0" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>
                <Image Source="/TamaPoke;component/Assets/UI/icon_ball.png" Width="18" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Grid>

            <ContentControl Style="{StaticResource PixelPanel}" Margin="0,0,46,5" Padding="8,5,8,5" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="128">
                <StackPanel>
                    <!-- 🌟 플레이어 이름, 상태이상, 레벨 패널 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <!-- 긴 이름(Mega Charizard X 등)은 잘리지 않게 글자를 줄여 맞춥니다. -->
                        <Viewbox Grid.Column="0" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PlayerBattleName}" FontSize="12" FontWeight="Bold" Foreground="#333"/>
                        </Viewbox>
                        <TextBlock Grid.Column="1" Text="{Binding Level, StringFormat={} Lv.{0}}" FontSize="11" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,4,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Style="{StaticResource PlayerAilmentPill}"
                                Visibility="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Visibility}"
                                Background="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Bg}"
                                BorderBrush="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Border}">
                            <TextBlock Text="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Text}" FontSize="8" FontWeight="Bold"
                                       Foreground="{Binding PlayerAilment, Converter={StaticResource AilmentStyle}, ConverterParameter=Fg}"/>
                        </Border>
                        <ProgressBar Value="{Binding PlayerHp}" Maximum="{Binding PlayerMaxHp}" Grid.Column="1" VerticalAlignment="Center">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource PixelBar}">
                                <Setter Property="Foreground" Value="{Binding PlayerHpColor}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsPlayerTakingDamage}" Value="True">
                                        <DataTrigger.EnterActions>
                                            <BeginStoryboard Name="PlayerBlinkAnim">
                                                <Storyboard RepeatBehavior="Forever">
                                                    <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1.0" To="0.3" Duration="0:0:0.1" AutoReverse="True"/>
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </DataTrigger.EnterActions>
                                        <DataTrigger.ExitActions>
                                            <StopStoryboard BeginStoryboardName="PlayerBlinkAnim"/>
                                        </DataTrigger.ExitActions>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    </Grid>
                    <TextBlock HorizontalAlignment="Right" FontSize="9" FontWeight="Bold" Foreground="#333" Margin="0,2,0,0">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0}/{1}">
                                <Binding Path="PlayerHp"/>
                                <Binding Path="PlayerMaxHp"/>
                            </MultiBinding>
                        </TextBlock.Text>
                    </TextBlock>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 2. 중앙 팝업 (포획 선택 창 등) -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsCatchOffered, Converter={StaticResource BoolToVis}}" Panel.ZIndex="100">
            <ContentControl Style="{StaticResource PixelPanel}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{u:T battle.ui.won}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{u:T battle.ui.catch}" Width="90" Height="35" Margin="0,0,10,0" Background="#E53935" Style="{StaticResource RoundedButtonStyle}" Click="Catch_Click"/>
                        <Button Content="{u:T battle.ui.moveOn}" Width="90" Height="35" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="Leave_Click"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 메가 폼 선택 창 (리자몽 X/Y처럼 메가 폼이 둘 이상일 때) -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsMegaChoiceOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="105">
            <ContentControl Style="{StaticResource PixelPanel}" Padding="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{u:T mega.battle.choose}" FontSize="13" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                    <ItemsControl ItemsSource="{Binding MegaChoices}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding DisplayName}" MinWidth="90" Height="32" Margin="4,0" Background="#8E24AA" Style="{StaticResource RoundedButtonStyle}" Click="MegaChoice_Click"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="{u:T common.cancel}" Width="120" Height="28" Margin="0,10,0,0" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="MegaCancel_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 스킬 학습 창 -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsSkillLearnMenuOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="110">
            <ContentControl Style="{StaticResource PixelPanel}" Padding="15" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{u:T battle.ui.newSkill}" FontSize="14" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Button Visibility="{Binding HasRecommendedSkill1, Converter={StaticResource BoolToVis}}" 
                                Width="100" Height="45" Margin="4,0" Style="{StaticResource PixelLightButton}" Click="BtnLearnSkill1_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendedSkill1.Name}" FontWeight="Bold" FontSize="11" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding RecommendedSkill1.Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RecommendedSkill1.Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Visibility="{Binding HasRecommendedSkill2, Converter={StaticResource BoolToVis}}" 
                                Width="100" Height="45" Margin="4,0" Style="{StaticResource PixelLightButton}" Click="BtnLearnSkill2_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding RecommendedSkill2.Name}" FontWeight="Bold" FontSize="11" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding RecommendedSkill2.Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding RecommendedSkill2.Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Button Content="{u:T battle.ui.dontLearn}" Width="208" Height="30" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="BtnSkipSkill_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 스킬 교체 창 -->
        <Grid Grid.RowSpan="2" Background="#99000000" Visibility="{Binding IsSkillReplaceMenuOpen, Converter={StaticResource BoolToVis}}" Panel.ZIndex="110">
            <ContentControl Style="{StaticResource PixelPanel}" Padding="20" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel>
                    <TextBlock Text="{u:T battle.ui.skillsFull}" TextAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,5"/>
                    <UniformGrid Columns="2" Rows="2" Margin="0,0,0,10">
                        <Button Margin="3" Height="45" Style="{StaticResource PixelLightButton}" Click="BtnReplaceSkill0_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[0].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding CurrentSkills[0].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[0].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Margin="3" Height="45" Style="{StaticResource PixelLightButton}" Click="BtnReplaceSkill1_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[1].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding CurrentSkills[1].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[1].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Margin="3" Height="45" Style="{StaticResource PixelLightButton}" Click="BtnReplaceSkill2_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[2].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding CurrentSkills[2].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[2].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                        <Button Margin="3" Height="45" Style="{StaticResource PixelLightButton}" Click="BtnReplaceSkill3_Click">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CurrentSkills[3].Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,3" HorizontalAlignment="Center"/>
                                <Border CornerRadius="1" Background="{Binding CurrentSkills[3].Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}" Padding="4,1" HorizontalAlignment="Center">
                                    <TextBlock Text="{Binding CurrentSkills[3].Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                </Border>
                            </StackPanel>
                        </Button>
                    </UniformGrid>
                    <Button Content="{u:T battle.ui.neverMind}" Width="150" Height="30" Background="#9E9E9E" Style="{StaticResource RoundedButtonStyle}" Click="BtnSkipSkill_Click"/>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 3. 하단 컨트롤 영역 -->
        <Grid Grid.Row="1" Background="#2B3048">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto" MinHeight="65"/>
            </Grid.RowDefinitions>

            <!-- 메시지 창 위쪽 픽셀 테두리 -->
            <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top" Fill="#161A28"/>
            <Rectangle Grid.RowSpan="2" Height="2" VerticalAlignment="Top" Margin="0,2,0,0" Fill="#4A5478"/>

            <TextBlock Grid.Row="0" Text="{Binding BattleMessage}" Foreground="White" FontSize="12" FontWeight="Bold" FontFamily="Consolas" Margin="10,5,10,5" TextWrapping="Wrap" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center"/>

            <Grid Grid.Row="1">
                <UniformGrid HorizontalAlignment="Center" Columns="2" Margin="0,0,0,10" Rows="2" 
                             Visibility="{Binding IsMainMenuVisible, Converter={StaticResource BoolToVis}}">
                    <Button Content="{u:T battle.ui.fight}" Width="66" Height="26" Margin="3" Background="#E53935" Style="{StaticResource RoundedButtonStyle}" Click="ShowAttackMenu_Click"/>
                    <Button Content="{u:T battle.ui.dodge}" Width="66" Height="26" Margin="3" Background="#1E88E5" Style="{StaticResource RoundedButtonStyle}" Click="Dodge_Click"/>
                    <Button Content="{u:T battle.ui.bag}" Width="66" Height="26" Margin="3" Background="#F0A000" Style="{StaticResource RoundedButtonStyle}" Click="OpenInventory_Click"/>
                    <Button Content="{u:T battle.ui.run}" Width="66" Height="26" Margin="3" Background="#757575" Style="{StaticResource RoundedButtonStyle}" Click="Run_Click"/>
                </UniformGrid>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10" Background="#2B3048" 
                            Visibility="{Binding IsAttackMenuOpen, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding CurrentSkills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <!-- 기술 버튼: 왼쪽 네모 = 타입 색 (타입 이름은 마우스를 올리면), 긴 기술 이름은 글자를 줄여 맞춤 -->
                                <Button Width="100" Height="26" Margin="4" Style="{StaticResource PixelLightButton}" Click="SkillButton_Click" ToolTip="{Binding Type}">
                                    <Grid Width="86">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Width="8" Height="8" Margin="0,0,4,0" VerticalAlignment="Center" BorderBrush="#2B2B36" BorderThickness="1"
                                                Background="{Binding Type, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}"/>
                                        <Viewbox Grid.Column="1" StretchDirection="DownOnly" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#333"/>
                                        </Viewbox>
                                    </Grid>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="◀" Width="45" Height="22" Margin="0,8,0,0" Style="{StaticResource PixelLightButton}" Background="#E0D8C8" Click="CancelAttack_Click">
                    </Button>
                </StackPanel>

                <!-- 동적 인벤토리 (가방) 창 -->
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,5" Background="#2B3048" 
                            Visibility="{Binding IsBattleInventoryOpen, Converter={StaticResource BoolToVis}}">
                    <ItemsControl ItemsSource="{Binding Inventory}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel MaxWidth="260" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Width="85" Height="25" Margin="3" Style="{StaticResource PixelLightButton}" Click="UseBattleItem_Click">
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="11" Foreground="#333" Margin="0,0,6,0"/>
                                        <TextBlock Text="{Binding Quantity, StringFormat={}x{0}}" FontSize="11" Foreground="#1E88E5" FontWeight="Bold"/>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button Content="◀" Width="45" Height="20" Style="{StaticResource PixelLightButton}" Background="#E0D8C8" Click="CloseInventory_Click" Margin="0,5,0,0">
                    </Button>
                </StackPanel>

            </Grid>
        </Grid>

        <!-- 패배 오버레이 -->
        <Grid Background="Black" Panel.ZIndex="999" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Opacity" Value="0"/>
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsDefeatedFadeOut}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:2"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
        </Grid>
    </Grid>
</UserControl>