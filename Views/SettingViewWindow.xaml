<Window x:Class="TamaPoke.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewmodels="clr-namespace:TamaPoke.ViewModels"
        Title="게임 설정" Height="440" Width="380"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.DataContext>
        <viewmodels:SettingsViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 1. 트레이 알림 설정 -->
        <CheckBox Grid.Row="0" Content="시스템 트레이 알림 사용" 
                  IsChecked="{Binding UseTrayNotifications}" 
                  VerticalContentAlignment="Center" Margin="0,0,0,15"/>

        <!-- 2. 이별 기준일 설정 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="이별 기준일 (일):" VerticalAlignment="Center" Width="100"/>
                <Slider Minimum="1" Maximum="30" Value="{Binding Settings.FarewellAgeDays, Mode=TwoWay}" Width="140" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Settings.FarewellAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <!-- 🌟 추천 가이드 문구 추가 -->
            <TextBlock Text="💡 추천은 최소 3일 이상입니다." FontSize="11" Foreground="#757575" Margin="100,4,0,0"/>
        </StackPanel>

        <!-- 3. 부화 세대 안내 텍스트 -->
        <TextBlock Grid.Row="2" Text="부화 대상 세대 선택 (지방별)" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 4. 세대별 체크박스 목록 (ItemsControl) -->
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Generations}" Margin="0,0,0,15">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayText}" 
                              IsChecked="{Binding IsSelected}" 
                              Margin="5,4" VerticalContentAlignment="Center"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 5. 저장 버튼 -->
        <Button Grid.Row="4" Content="저장 및 닫기" 
                Command="{Binding SaveCommand}" 
                Width="110" Height="32" HorizontalAlignment="Right"/>
    </Grid>
</Window>