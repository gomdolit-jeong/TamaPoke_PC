<Window x:Class="TamaPoke.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
        xmlns:viewmodels="clr-namespace:TamaPoke.ViewModels"
        xmlns:models="clr-namespace:TamaPoke.Models"
        Title="{u:T settings.title}" Height="640" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize">

    <Window.DataContext>
        <viewmodels:SettingsViewModel />
    </Window.DataContext>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <!-- 언어 선택 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <!-- 🌟 포켓몬 수를 위한 새 행 -->
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 0. 언어 선택 (저장하면 즉시 적용) -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <TextBlock Text="{u:T settings.language}" VerticalAlignment="Center" Width="120"/>
            <ComboBox ItemsSource="{Binding Languages}" SelectedValue="{Binding SelectedLanguage}"
                      SelectedValuePath="Code" DisplayMemberPath="Name" Width="175" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 1. 트레이 알림 설정 -->
        <CheckBox Grid.Row="1" Content="{u:T settings.tray}" 
                  IsChecked="{Binding UseTrayNotifications}" 
                  VerticalContentAlignment="Center" Margin="0,0,0,15"/>

        <!-- 2. 이별 기준일 설정 -->
        <StackPanel Grid.Row="2" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{u:T settings.farewell}" VerticalAlignment="Center" Width="120"/>
                <Slider Minimum="1" Maximum="30" Value="{Binding Settings.FarewellAgeDays, Mode=TwoWay}" Width="120" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Settings.FarewellAgeDays, UpdateSourceTrigger=PropertyChanged}" Width="45" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{u:T settings.farewell.hint}" FontSize="11" Foreground="#757575" Margin="120,4,0,0"/>
        </StackPanel>

        <!-- 🌟 3. 바탕화면 포켓몬 설정 그룹 (수 조절 + 크기 조절 통합) -->
        <StackPanel Grid.Row="3" Margin="0,0,0,20">

            <!-- 포켓몬 수 설정 영역 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{u:T settings.roamCount}" VerticalAlignment="Center" Width="120"/>
                <Slider Minimum="1" Maximum="6" 
                        Value="{Binding RoamingPokemonCount, Mode=TwoWay}" 
                        Width="120" TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <TextBox Text="{Binding Settings.RoamingPokemonCount, UpdateSourceTrigger=PropertyChanged}" 
                         Width="45" Margin="10,0,0,0" TextAlignment="Center" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{u:T settings.roamCount.hint}" FontSize="11" Foreground="#757575" Margin="120,4,0,15"/>

            <!-- 🌟 [새로 추가된 코드] 포켓몬 크기 설정 영역 -->
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{u:T settings.scale}" VerticalAlignment="Center" Width="120"/>
                <!-- 0.5배부터 5배까지 0.5 단위 (범위는 GameSettings.MinPetScale / MaxPetScale) -->
                <Slider Minimum="{x:Static models:GameSettings.MinPetScale}" Maximum="{x:Static models:GameSettings.MaxPetScale}" 
                        Value="{Binding Settings.RoamingPetScale, Mode=TwoWay}" 
                        Width="120" TickFrequency="0.5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Width="50" Margin="10,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Settings.RoamingPetScale, StringFormat={}{0:F1}}" FontWeight="Bold"/>
                    <TextBlock Text="{u:T settings.scale.unit}" FontWeight="Bold" Margin="2,0,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock Text="{u:T settings.scale.hint}" FontSize="11" Foreground="#757575" Margin="120,4,0,15"/>

            <!-- 작업표시줄 설정 영역 -->
            <CheckBox Content="{u:T settings.taskbar}" 
                      IsChecked="{Binding IsTaskbarMode}" 
                      VerticalContentAlignment="Center" Margin="0,0,0,0"/>

        </StackPanel>

        <!-- 4. 부화 세대 안내 텍스트 -->
        <TextBlock Grid.Row="4" Text="{u:T settings.generations}" FontWeight="Bold" Margin="0,0,0,10"/>

        <!-- 5. 세대별 체크박스 목록 -->
        <ItemsControl Grid.Row="5" ItemsSource="{Binding Generations}" Margin="0,0,0,15">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Vertical"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <CheckBox Content="{Binding DisplayText}" 
                              IsChecked="{Binding IsSelected}" 
                              Margin="5,4" VerticalContentAlignment="Center"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 6. 하단 버튼 영역 (초기화 및 저장) -->
        <Grid Grid.Row="6" Margin="0,10,0,0">
            <!-- 🌟 왼쪽: 빨간색 공장 초기화 버튼 (Click 이벤트로 변경) -->
            <Button Content="{u:T settings.reset}" 
                    Click="FactoryReset_Click" 
                    Width="110" Height="32" HorizontalAlignment="Left"
                    Background="#D32F2F" Foreground="White" FontWeight="Bold"
                    ToolTip="{u:T settings.reset.tooltip}"/>

            <!-- 오른쪽: 저장 및 닫기 버튼 -->
            <Button Content="{u:T settings.save}" 
                    Command="{Binding SaveCommand}" 
                    Width="110" Height="32" HorizontalAlignment="Right"/>
        </Grid>
    </Grid>
</Window>