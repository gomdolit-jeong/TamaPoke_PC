<UserControl x:Class="TamaPoke.Views.RoamingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             Background="Transparent">

    <!-- 🌟 핵심: 몬스터볼 테두리나 UI 없이, 오직 투명한 바탕에 포켓몬 이미지만 띄웁니다. -->
    <Grid Background="Transparent">

        <!-- 💎 산책 중 메가진화 연출: 포켓몬 뒤에서 빛과 무지개 고리가 돕니다. (배틀 연출과 같은 모양) -->
        <!-- 프레임 안에서 포켓몬 몸통은 가운데보다 조금 위에 그려지므로 고리도 살짝 올립니다. -->
        <Grid Width="52" Height="52" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,16" IsHitTestVisible="False">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>
            <Ellipse>
                <Ellipse.Fill>
                    <RadialGradientBrush>
                        <GradientStop Color="#CCFFFFFF" Offset="0"/>
                        <GradientStop Color="#66FFD54F" Offset="0.5"/>
                        <GradientStop Color="#00FFFFFF" Offset="1"/>
                    </RadialGradientBrush>
                </Ellipse.Fill>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="WalkMegaGlowAnim">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0.4" To="1" Duration="0:0:0.35" AutoReverse="True"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="WalkMegaGlowAnim"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
            <Ellipse Margin="8" StrokeThickness="2.5" RenderTransformOrigin="0.5,0.5">
                <Ellipse.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#FF5252" Offset="0"/>
                        <GradientStop Color="#FFD740" Offset="0.25"/>
                        <GradientStop Color="#69F0AE" Offset="0.5"/>
                        <GradientStop Color="#40C4FF" Offset="0.75"/>
                        <GradientStop Color="#E040FB" Offset="1"/>
                    </LinearGradientBrush>
                </Ellipse.Stroke>
                <Ellipse.RenderTransform>
                    <RotateTransform/>
                </Ellipse.RenderTransform>
                <Ellipse.Style>
                    <Style TargetType="Ellipse">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsMegaEvolving}" Value="True">
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="WalkMegaRingAnim">
                                        <Storyboard RepeatBehavior="Forever">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="0" To="360" Duration="0:0:0.8"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="WalkMegaRingAnim"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Ellipse.Style>
            </Ellipse>
        </Grid>

        <!-- IdleView에서 포켓몬을 그리는 로직만 그대로 가져왔습니다! -->
        <!-- Stretch="None": 모션마다 프레임 크기가 달라도 포켓몬 크기가 일정하게 유지됩니다. -->
        <Image Source="{Binding CurrentFrame}" 
               Stretch="None"
               HorizontalAlignment="Center" VerticalAlignment="Center"
               RenderOptions.BitmapScalingMode="NearestNeighbor" 
               RenderTransformOrigin="0.5,0.5">
            <Image.RenderTransform>
                <TransformGroup>
                    <!-- 이동 방향에 따라 좌우를 바라보게 해주는 바인딩 -->
                    <ScaleTransform ScaleX="{Binding FlipX}"/>
                    <!-- 걷거나 숨 쉴 때 미세하게 움직이는 바인딩 -->
                    <TranslateTransform X="{Binding PosX}" Y="{Binding PosY}"/>
                </TransformGroup>
            </Image.RenderTransform>
        </Image>

        <!-- 풀숲 뒤적이기: 포켓몬 몸 아래쪽을 덮는 풀숲이 좌우로 흔들립니다. (포켓몬보다 앞에 그려서 뛰어든 것처럼 보이게)
             PMD 프레임은 포켓몬이 가운데에 있으므로, 프레임 가장자리가 아닌 가운데를 기준으로 배치합니다. -->
        <Grid IsHitTestVisible="False">
            <Viewbox Width="40" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"
                     Margin="0,0,0,6" RenderTransformOrigin="0.5,1" RenderOptions.BitmapScalingMode="NearestNeighbor">
                <Viewbox.RenderTransform>
                    <RotateTransform Angle="0"/>
                </Viewbox.RenderTransform>
                <Viewbox.Style>
                    <Style TargetType="Viewbox">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsRummaging}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                                <DataTrigger.EnterActions>
                                    <BeginStoryboard Name="RustleAnim">
                                        <Storyboard RepeatBehavior="Forever" AutoReverse="True">
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)" From="-7" To="7" Duration="0:0:0.15"/>
                                        </Storyboard>
                                    </BeginStoryboard>
                                </DataTrigger.EnterActions>
                                <DataTrigger.ExitActions>
                                    <StopStoryboard BeginStoryboardName="RustleAnim"/>
                                </DataTrigger.ExitActions>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Viewbox.Style>
                <!-- 픽셀 풀숲 (40x20, 포켓몬 그림과 같은 1배): 뒤쪽 진한 풀잎 + 앞쪽 밝은 풀잎 -->
                <Image Source="/TamaPoke;component/Assets/UI/fx_bush.png" Width="40" Height="20" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
            </Viewbox>
        </Grid>

        <!-- 머리 위 말풍선 (산책 중 아이템을 주웠을 때 등): 나타날 때 아래에서 살짝 떠오릅니다. -->
        <Image Source="{Binding RoamingBubble, NotifyOnTargetUpdated=True}" Width="18" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,58" IsHitTestVisible="False">
            <Image.RenderTransform>
                <TranslateTransform Y="0"/>
            </Image.RenderTransform>
            <Image.Style>
                <Style TargetType="Image">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding RoamingBubble}" Value="{x:Null}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Image.Style>
            <Image.Triggers>
                <EventTrigger RoutedEvent="Binding.TargetUpdated">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.3"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="8" To="0" Duration="0:0:0.4"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Image.Triggers>
        </Image>
    </Grid>

</UserControl>