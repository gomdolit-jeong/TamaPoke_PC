<UserControl x:Class="TamaPoke.Views.PartyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <Border Background="#F7F3E8" CornerRadius="144" Width="288" Height="288" BorderBrush="Black" BorderThickness="1.5">
        <Grid Margin="10,15,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 상단 타이틀 영역 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center" Margin="0,5,0,0">
                <TextBlock Text="파티 멤버" FontSize="18" FontWeight="Bold" FontFamily="Malgun Gothic" HorizontalAlignment="Center"/>
                <TextBlock Text="{Binding Party.Count, StringFormat='파티원 {0}/6마리'}" FontSize="9" Foreground="#A9A9A9" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,1,0,0"/>
                <TextBlock Text="파티가 꽉 찼습니다! 내보낼 멤버를 클릭하세요." 
                           Foreground="#E53935" FontSize="11" FontWeight="Bold" FontFamily="Malgun Gothic" 
                           HorizontalAlignment="Center" Margin="0,5,0,0"
                           Visibility="{Binding IsSwapMode, Converter={StaticResource BoolToVis}}"/>
            </StackPanel>

            <!-- 2. 파티 멤버 6칸 그리드 -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Party}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,5,0,5">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- 🌟 테두리 스타일: 기본 -> 대표(노랑) -> 선택(빨강) 순으로 적용됩니다 -->
                        <Border CornerRadius="6" Margin="3" Width="125" Height="55" Cursor="Hand" MouseLeftButtonDown="PartyMemberCard_Click">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="BorderBrush" Value="#DDDDDD"/>
                                    <Setter Property="BorderThickness" Value="1"/>
                                    <Setter Property="Background" Value="White"/>
                                    <Style.Triggers>
                                        <!-- 1단계: 첫 번째 포켓몬은 노란색 테두리 -->
                                        <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                            <Setter Property="BorderBrush" Value="#FFC107"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                        </DataTrigger>
                                        <!-- 2단계: 선택되면 우선적으로 빨간색 테두리와 배경 적용 -->
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter Property="BorderBrush" Value="#E53935"/>
                                            <Setter Property="BorderThickness" Value="2"/>
                                            <Setter Property="Background" Value="#FFF0F0"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="45"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 포켓몬 이미지 배경 및 이미지 -->
                                <Border Grid.Column="0" Background="#EEEEEE" CornerRadius="4" Margin="3"/>
                                <Image Grid.Column="0" Source="{Binding SpriteImage}" Width="36" Height="36" 
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                <!-- 포켓몬 정보 텍스트 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="3,0,0,0">
                                    <TextBlock Text="{Binding Name}" FontFamily="Consolas" FontWeight="Bold" FontSize="10" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LevelDisplay}" FontFamily="Consolas" FontSize="10" Margin="0,0,0,2"/>

                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Type1Display}" FontFamily="Consolas" FontSize="8" Foreground="#E53935" FontWeight="Bold" Margin="0,0,4,0"/>
                                        <TextBlock Text="{Binding Type2Display}" FontFamily="Consolas" FontSize="8" Foreground="#1E88E5" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 🌟 뱃지 영역: StackPanel을 사용하여 '대표'와 '선택' 뱃지가 나란히 뜰 수 있게 구성 -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0">

                                    <!-- 대표 뱃지 (노란색) -->
                                    <Border Background="#FFC107" CornerRadius="4" Padding="4,2" Margin="0,0,2,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="대표" FontSize="8" FontWeight="Bold" Foreground="White" FontFamily="Malgun Gothic"/>
                                    </Border>

                                    <!-- 선택 뱃지 (빨간색) -->
                                    <Border Background="#E53935" CornerRadius="4" Padding="4,2">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="선택" FontSize="8" FontWeight="Bold" Foreground="White" FontFamily="Malgun Gothic"/>
                                    </Border>

                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. 하단 버튼 영역 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                <Button Width="70" Height="28" Margin="0,0,8,0" Click="CloseButton_Click">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="#E0DBC8" BorderBrush="Black" BorderThickness="1" CornerRadius="6">
                                <TextBlock Text="◀️" FontFamily="Malgun Gothic" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Width="70" Height="28" Margin="8,0,0,0" Click="ChangeMainButton_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ActionBorder" Background="#1E88E5" BorderBrush="Black" BorderThickness="1" CornerRadius="6">
                                            <TextBlock x:Name="ActionText" Text="메인 교체" FontFamily="Malgun Gothic" FontWeight="Bold" FontSize="12" Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsSwapMode}" Value="True">
                                                <Setter TargetName="ActionBorder" Property="Background" Value="#E53935"/>
                                                <Setter TargetName="ActionText" Property="Text" Value="교체"/>
                                            </DataTrigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
            <Grid x:Name="SwapConfirmOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Margin="-10,-15,-10,-10">
                <Border Background="White" CornerRadius="12" Width="200" Height="110" HorizontalAlignment="Center" VerticalAlignment="Center" BorderBrush="#333333" BorderThickness="2">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="10">
                        <TextBlock x:Name="ConfirmPopupText" Text="교체하시겠습니까?" FontWeight="Bold" FontSize="12" FontFamily="Malgun Gothic" HorizontalAlignment="Center" Margin="0,0,0,15" TextWrapping="Wrap" TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="예" Width="50" Height="25" Margin="0,0,10,0" Background="#1E88E5" Foreground="White" FontWeight="Bold" Click="ConfirmYes_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                            <Button Content="아니요" Width="50" Height="25" Background="#E53935" Foreground="White" FontWeight="Bold" Click="ConfirmNo_Click">
                                <Button.Resources>
                                    <Style TargetType="Border">
                                        <Setter Property="CornerRadius" Value="4"/>
                                    </Style>
                                </Button.Resources>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>