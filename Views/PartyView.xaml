<UserControl x:Class="TamaPoke.Views.PartyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lc="clr-namespace:TamaPoke.Converters"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             mc:Ignorable="d"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 픽셀 버튼/상자 (대기 화면, 배틀 화면과 같은 스타일) -->
                <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVis"/>

            <!-- 🌟 스킬 창에서 만들었던 타입->색상 변환기를 파티 화면에도 등록합니다! -->
            <conv:TypeToColorConverter x:Key="TypeToColor"/>

            <!-- 파티원 카드: 픽셀 칸. 대표는 금빛, 선택한 카드는 붉은빛 -->
            <Style TargetType="ContentControl" x:Key="MemberCard" BasedOn="{StaticResource PixelTile}">
                <Setter Property="Margin" Value="2,5,2,0"/>
                <Setter Property="Width" Value="114"/>
                <Setter Property="Height" Value="48"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Stretch"/>
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                        <Setter Property="Background" Value="#FFF0BE"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                        <Setter Property="Background" Value="#FFD8D2"/>
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 카드 위쪽 테두리에 걸치는 작은 딱지 (대표 / 선택) -->
            <Style TargetType="Border" x:Key="CardTag" BasedOn="{StaticResource PixelTag}">
                <Setter Property="Padding" Value="3,0,3,1"/>
                <Setter Property="Margin" Value="0,0,2,0"/>
                <Setter Property="Visibility" Value="Collapsed"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border Background="#F1ECDD" CornerRadius="144" Width="288" Height="288">
        <Grid Margin="0,22,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 상단 타이틀 영역 -->
            <!-- 원의 위쪽은 좁으므로 제목 아래 한 줄만 씁니다: 평소엔 인원수, 파티가 꽉 찼을 땐 교체 안내 -->
            <StackPanel Grid.Row="0" HorizontalAlignment="Center">
                <TextBlock Text="{u:T party.title}" FontSize="17" FontWeight="Bold" FontFamily="Malgun Gothic" Foreground="#333" HorizontalAlignment="Center"/>
                <Grid Margin="0,1,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="{Binding Party.Count, Converter={x:Static lc:LocFormatConverter.Instance}, ConverterParameter=party.count}" FontSize="9" Foreground="#8C8676" FontFamily="Consolas" HorizontalAlignment="Center">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSwapMode}" Value="True">
                                        <Setter Property="Visibility" Value="Hidden"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{u:T party.full}" Foreground="#E53935" FontSize="9.5" FontWeight="Bold" FontFamily="Malgun Gothic"
                               HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="210"
                               Visibility="{Binding IsSwapMode, Converter={StaticResource BoolToVis}}"/>
                </Grid>
            </StackPanel>

            <!-- 2. 파티 멤버 6칸 그리드 -->
            <ItemsControl Grid.Row="1" ItemsSource="{Binding Party}" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,4,0,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="2" Rows="3" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <ContentControl Style="{StaticResource MemberCard}" MouseLeftButtonDown="PartyMemberCard_Click">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!-- 포켓몬 이미지 칸 -->
                                <Rectangle Grid.Column="0" Fill="#E4DDC8" Margin="5,5,3,5"/>
                                <Image Grid.Column="0" Source="{Binding SpriteImage}" Width="32" Height="32" Margin="2,0,0,0"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="NearestNeighbor" />

                                <!-- 포켓몬 정보 텍스트 -->
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="1,0,4,0">
                                    <TextBlock Text="{Binding DisplayName}" FontFamily="Malgun Gothic" FontWeight="Bold" FontSize="10" Foreground="#333" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding LevelDisplay}" FontFamily="Consolas" FontSize="9" Foreground="#555"/>

                                    <!-- 타입 딱지 (두 개가 카드 폭에 들어가도록 작게) -->
                                    <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                        <Border Style="{StaticResource PixelTag}" Padding="2,0,2,0" Margin="0,0,2,0"
                                                Background="{Binding Type1Display, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}">
                                            <TextBlock Text="{Binding Type1Display}" FontFamily="Consolas" FontSize="7" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                        <Border Padding="2,0,2,0"
                                                Background="{Binding Type2Display, Converter={StaticResource TypeToColor}, FallbackValue=#78909C}">
                                            <Border.Style>
                                                <Style TargetType="Border" BasedOn="{StaticResource PixelTag}">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                    <!-- 🌟 타입2가 없거나 'None'일 경우 빈 상자가 뜨지 않도록 숨겨줍니다 -->
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Type2Display}" Value="">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Type2Display}" Value="None">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Type2Display}" FontFamily="Consolas" FontSize="7" Foreground="White" FontWeight="Bold"/>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>

                                <!-- 딱지: 대표 및 선택 (카드 위쪽 테두리에 걸친 태그라 이름을 가리지 않음) -->
                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-7,4,0">
                                    <Border Background="#F2B300">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardTag}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsFirst}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{u:T party.lead}" FontSize="7.5" FontWeight="Bold" Foreground="White" FontFamily="Malgun Gothic"/>
                                    </Border>

                                    <Border Background="#E53935">
                                        <Border.Style>
                                            <Style TargetType="Border" BasedOn="{StaticResource CardTag}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{u:T party.selected}" FontSize="7.5" FontWeight="Bold" Foreground="White" FontFamily="Malgun Gothic"/>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- 3. 하단 버튼 영역: 뒤로 / 메인 교체 (파티가 꽉 차서 교체할 때는 "교체") -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,18">
                <Button Width="32" Height="28" Margin="0,0,8,0" Style="{StaticResource PixelLightButton}" Padding="0" Click="CloseButton_Click">
                    <Image Source="/TamaPoke;component/Assets/UI/arrow_left.png" Width="10" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Button>

                <Button Width="76" Height="28" Margin="8,0,0,0" FontSize="12" Click="ChangeMainButton_Click">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource PixelTextButton}">
                            <Setter Property="Background" Value="#1E88E5"/>
                            <Setter Property="Content" Value="{u:T party.makeLead}"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSwapMode}" Value="True">
                                    <Setter Property="Background" Value="#E53935"/>
                                    <Setter Property="Content" Value="{u:T party.swap}"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>

            <Grid x:Name="SwapConfirmOverlay" Grid.RowSpan="3" Background="#99000000" Visibility="Collapsed" Margin="0,-22,0,0">
                <ContentControl Style="{StaticResource PixelPanel}" Width="210" Padding="12,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                        <TextBlock x:Name="ConfirmPopupText" Text="{u:T party.swap.confirm}" FontWeight="Bold" FontSize="12" FontFamily="Malgun Gothic" Foreground="#333" HorizontalAlignment="Center" Margin="0,0,0,12" TextWrapping="Wrap" TextAlignment="Center"/>

                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <Button Content="{u:T common.yes}" Width="56" Height="26" Margin="0,0,10,0" Style="{StaticResource PixelTextButton}" Background="#1E88E5" Click="ConfirmYes_Click"/>
                            <Button Content="{u:T common.no}" Width="56" Height="26" Style="{StaticResource PixelTextButton}" Background="#E53935" Click="ConfirmNo_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ContentControl>
            </Grid>
        </Grid>
    </Border>
</UserControl>
