<Window x:Class="TamaPoke.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="다마포케 통합 업데이트" Height="420" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="True">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="업데이트할 항목을 선택해 주세요." 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- 🌟 선택형 체크박스 패널 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15" Background="#F0F0F0">
            <CheckBox x:Name="chkData" Content="1. 포켓몬 기본 정보 업데이트 (이름, 종족값 등)" IsChecked="True" Margin="10,10,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkSkill" Content="2. 포켓몬 스킬 트리 업데이트 (레벨업 스킬)" IsChecked="True" Margin="10,5,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkSprite" Content="3. 누락된 포켓몬 스프라이트(이미지) 검사 및 다운로드" IsChecked="True" Margin="10,5,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkProgram" Content="4. 다마포케 프로그램 최신 버전 확인 및 적용" IsChecked="True" Margin="10,5,10,10" FontWeight="Bold"/>
        </StackPanel>

        <!-- 🌟 업데이트 시작 버튼 -->
        <Button x:Name="btnStartUpdate" Grid.Row="2" Content="선택한 항목 업데이트 시작 ▶" Height="35" 
                FontWeight="Bold" Background="#4CAF50" Foreground="White" Margin="0,0,0,15" Click="btnStartUpdate_Click"/>

        <!-- 🌟 진행률 프로그레스 바 -->
        <ProgressBar x:Name="pbStatus" Grid.Row="3" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,10"/>

        <!-- 🌟 실시간 로그 리스트 박스 -->
        <ListBox x:Name="lbLogs" Grid.Row="4" Background="#F5F5F5" FontFamily="Consolas" FontSize="12" Margin="0,0,0,15"/>

        <!-- 🌟 닫기 버튼 -->
        <Button x:Name="btnClose" Grid.Row="5" Content="닫기" Height="35" 
                FontWeight="Bold" IsEnabled="True" Click="btnClose_Click"/>
    </Grid>
</Window>