<Window x:Class="TamaPoke.Views.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lc="clr-namespace:TamaPoke.Converters"
             xmlns:u="clr-namespace:TamaPoke.Utils"
        Title="{u:T tray.update}" Height="600" Width="450"
        WindowStartupLocation="CenterScreen"
        WindowStyle="ToolWindow"
        ResizeMode="NoResize"
        Topmost="False">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="{u:T update.choose}" 
                   FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

        <!-- 🌟 선택형 체크박스 패널 -->
        <StackPanel Grid.Row="1" Margin="0,0,0,15" Background="#F0F0F0">
            <CheckBox x:Name="chkData" Content="{u:T update.opt.data}" IsChecked="True" Margin="10,5,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkSkill" Content="{u:T update.opt.skill}" IsChecked="True" Margin="10,5,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkSprite" Content="{u:T update.opt.sprite}" IsChecked="True" Margin="10,5,10,5" FontWeight="Bold"/>
            <CheckBox x:Name="chkProgram" Content="{u:T update.opt.program}" IsChecked="True" Margin="10,5,10,10" FontWeight="Bold"/>
        </StackPanel>

        <!-- 🌟 업데이트 시작 버튼 -->
        <Button x:Name="btnStartUpdate" Grid.Row="2" Content="{u:T update.start}" Height="35" 
                FontWeight="Bold" Background="#4CAF50" Foreground="White" Margin="0,0,0,15" Click="btnStartUpdate_Click"/>

        <!-- 🌟 진행률 프로그레스 바 -->
        <ProgressBar x:Name="pbStatus" Grid.Row="3" Height="20" Minimum="0" Maximum="100" Margin="0,0,0,10"/>

        <!-- 🌟 실시간 로그 리스트 박스 -->
        <ListBox x:Name="lbLogs" Grid.Row="4" Background="#F5F5F5" FontFamily="Consolas" FontSize="12" Margin="0,0,0,15"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
            <!-- 가로 스크롤을 꺼서 줄바꿈이 일어날 공간을 만듭니다. -->
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <!-- TextWrapping="Wrap" 속성이 긴 텍스트를 자동으로 아래로 줄바꿈해 줍니다. -->
                    <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,2"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        
        <!-- 🌟 닫기 버튼 -->
        <Button x:Name="btnClose" Grid.Row="5" Content="{u:T common.close}" Height="35" 
                FontWeight="Bold" IsEnabled="True" Click="btnClose_Click"/>
    </Grid>
</Window>