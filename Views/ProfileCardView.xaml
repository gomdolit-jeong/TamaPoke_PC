<UserControl x:Class="TamaPoke.Views.ProfileCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TamaPoke.Utils.Service"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             Height="288" Width="288" 
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BadgeUnlockedConverter x:Key="BadgeUnlocked"/>

        <!-- 🌟 새롭게 추가한 타입->색상 변환기를 등록합니다 -->
        <conv:TypeToColorConverter x:Key="TypeToColor"/>

        <!-- 메달 뱃지 공통 스타일 -->
        <Style TargetType="Border" x:Key="MedalBadgeStyle">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Background" Value="#DDDDDD"/>
            <Setter Property="TextBlock.Foreground" Value="#999999"/>
            <Setter Property="Height" Value="24"/>
        </Style>

        <!-- 체육관 뱃지 버튼 공통 스타일 -->
        <Style TargetType="Button" x:Key="GymBtnStyle">
            <Setter Property="Background" Value="#F5F5F5"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="#F8F9FA" ClipToBounds="True">
        <Grid.Clip>
            <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
        </Grid.Clip>

        <!-- 🌟 체육관 도전 확인 오버레이 창 -->
        <Grid Background="#99000000" Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGymConfirmOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <Border Width="200" Height="110" Background="White" CornerRadius="12" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
                </Border.Effect>
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <!-- 🌟 헷갈리는 StringFormat 대신 Run과 LineBreak 태그를 사용하여 안전하게 줄바꿈합니다 -->
                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#333333" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Run Text="{Binding SelectedGymLeader.GymName}"/>
                        <Run Text="에"/>
                        <LineBreak/>
                        <Run Text="도전하시겠습니까?"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="도전하기" Width="80" Height="28" Margin="4,0" Background="#E53935" Foreground="White" FontWeight="Bold" FontSize="11" Click="ConfirmGym_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button Content="취소" Width="60" Height="28" Margin="4,0" Background="#757575" Foreground="White" FontWeight="Bold" FontSize="11" Click="CancelGym_Click" Cursor="Hand">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="6"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 공통 상단/좌우 버튼 -->
        <Button Content="X 닫기" FontSize="11" FontWeight="Bold" Background="#E53935" Foreground="White" Width="60" Height="22" Margin="0,15,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Click="Close_Click" Cursor="Hand">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="11"/>
                </Style>
            </Button.Resources>
        </Button>
        <Button Content="◀" FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#888" Width="30" Height="60" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="Hand" Click="PrevPage_Click"/>
        <Button Content="▶" FontSize="20" FontWeight="Bold" Background="Transparent" BorderThickness="0" Foreground="#888" Width="30" Height="60" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="Hand" Click="NextPage_Click"/>

        <!-- 메인 컨텐츠 영역 -->
