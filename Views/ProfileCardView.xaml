<UserControl x:Class="TamaPoke.Views.ProfileCardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:lc="clr-namespace:TamaPoke.Converters"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             xmlns:local="clr-namespace:TamaPoke.Utils.Service"
             xmlns:emoji="clr-namespace:Emoji.Wpf;assembly=Emoji.Wpf"
             xmlns:conv="clr-namespace:TamaPoke.Converters"
             Height="288" Width="288" 
             HorizontalAlignment="Center" VerticalAlignment="Center">

    <UserControl.Resources>
        <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <!-- 픽셀 버튼/상자/바 (대기 화면, 배틀 화면과 같은 스타일) -->
            <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
        </ResourceDictionary.MergedDictionaries>

        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
        <conv:BadgeUnlockedConverter x:Key="BadgeUnlocked"/>

        <!-- 🌟 새롭게 추가한 타입->색상 변환기를 등록합니다 -->
        <conv:TypeToColorConverter x:Key="TypeToColor"/>

        <!-- 메달: 픽셀 칸 (없으면 회색, 얻으면 초록) -->
        <Style TargetType="ContentControl" x:Key="MedalBadgeStyle" BasedOn="{StaticResource PixelTile}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="Background" Value="#DCD7C9"/>
            <Setter Property="Foreground" Value="#8E8A7E"/>
        </Style>

        <!-- ========================================== -->
        <!-- 🌟 1. 체육관 뱃지 버튼 공통 스타일 -->
        <!-- ========================================== -->
        <Style TargetType="Button" x:Key="GymBtnStyle" BasedOn="{StaticResource PixelLightButton}">
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="0"/>
        </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="#F1ECDD" ClipToBounds="True">
        <Grid.Clip>
            <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
        </Grid.Clip>

        <!-- 🌟 체육관 도전 확인 오버레이 창 -->
        <Grid Background="#99000000" Panel.ZIndex="100">
            <Grid.Style>
                <Style TargetType="Grid">
                    <Setter Property="Visibility" Value="Collapsed"/>
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding IsGymConfirmOpen}" Value="True">
                            <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Style>

            <ContentControl Style="{StaticResource PixelPanel}" Width="210" Padding="12,14" HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">

                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="#333333" TextAlignment="Center" HorizontalAlignment="Center" Margin="0,0,0,12">
                        <Run Text="{Binding GymChallengePrompt, Mode=OneWay}"/>
                    </TextBlock>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Content="{u:T profile.challenge}" Width="80" Height="28" Margin="4,0" Style="{StaticResource PixelTextButton}" Background="#E53935" FontWeight="Bold" FontSize="11" Click="ConfirmGym_Click" Cursor="Hand"/>
                        <Button Content="{u:T common.cancel}" Width="60" Height="28" Margin="4,0" Style="{StaticResource PixelTextButton}" Background="#757575" FontWeight="Bold" FontSize="11" Click="CancelGym_Click" Cursor="Hand"/>
                    </StackPanel>
                </StackPanel>
            </ContentControl>
        </Grid>

        <!-- 공통 상단/좌우 버튼 -->
        <Button Content="{u:T profile.close}" FontSize="11" FontWeight="Bold" Style="{StaticResource PixelTextButton}" Background="#E53935" Width="60" Height="22" Margin="0,5,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" Click="Close_Click" Cursor="Hand"/>
        <Button Style="{StaticResource PixelArrowButton}" Margin="5,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Click="PrevPage_Click">
            <Image Source="/TamaPoke;component/Assets/UI/arrow_left.png" Width="10" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Button>
        <Button Style="{StaticResource PixelArrowButton}" Margin="0,0,5,0" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NextPage_Click">
            <Image Source="/TamaPoke;component/Assets/UI/arrow_right.png" Width="10" Height="18" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
        </Button>

        <!-- 메인 컨텐츠 영역 -->
        <Grid Margin="35,40,35,35">

            <!-- ========================================== -->
            <!-- 🌟 페이지 1 (Value="0"): 체육관 뱃지 스크롤 화면 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{u:T profile.gyms}" FontSize="15" FontWeight="Bold" FontFamily="Consolas" HorizontalAlignment="Center" Margin="0,0,0,5" Foreground="#E53935"/>

                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Width="220" Height="140" Margin="0,0,0,8" Padding="0,0,5,0">

                        <ItemsControl ItemsSource="{Binding BadgeGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding HeaderText}" FontSize="11" FontWeight="Bold" Foreground="#666" Margin="4,4,0,2"/>
                                        <Rectangle Height="2" Fill="#D2CAB4" Margin="0,0,0,4" SnapsToDevicePixels="True"/>

                                        <ItemsControl ItemsSource="{Binding Badges}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid Columns="4" Rows="2" Height="100" Margin="0,0,0,5" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>

                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Tag="{Binding GlobalIndex}" Click="GymBadge_Click" Style="{StaticResource GymBtnStyle}" Width="44" Height="44">
                                                        <Image Source="{Binding ImagePath}" Width="40" Height="40" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"> <!-- 20x20 도트 배지를 정확히 2배로 -->
                                                            <Image.Style>
                                                                <Style TargetType="Image">
                                                                    <Setter Property="Opacity" Value="0.2"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Value="True">
                                                                            <DataTrigger.Binding>
                                                                                <MultiBinding Converter="{StaticResource BadgeUnlocked}">
                                                                                    <Binding Path="DataContext.GymBadges" RelativeSource="{RelativeSource AncestorType=UserControl}"/>
                                                                                    <Binding Path="GlobalIndex"/>
                                                                                </MultiBinding>
                                                                            </DataTrigger.Binding>
                                                                            <Setter Property="Opacity" Value="1.0"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Image.Style>
                                                        </Image>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <TextBlock Text="{Binding GymBadges, Converter={x:Static lc:LocFormatConverter.Instance}, ConverterParameter=profile.badges}" FontSize="13" FontWeight="Bold" FontFamily="Consolas" Foreground="#333" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 🌟 페이지 2 (Value="1"): 기본 프로필 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="1">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <!-- 🌟 이름과 성별 기호를 가로로 나란히 배치합니다 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="17" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding GenderDisplay}" FontSize="15" FontWeight="Bold" Foreground="{Binding GenderColor}" Margin="4,1,0,0" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{Binding FormDescription}" FontSize="11" FontWeight="SemiBold" Foreground="#757575" HorizontalAlignment="Center" Margin="0,1,0,0"/>

                    <Image Source="{Binding CurrentFrame}" Width="64" Height="64" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,3"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_streak.png" Style="{StaticResource PixelIcon}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.streak}" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding Streak, Converter={x:Static lc:LocFormatConverter.Instance}, ConverterParameter=profile.streak.days}" FontSize="14" FontWeight="Bold" Foreground="#E65100" HorizontalAlignment="Center" Margin="0,0,0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_heart.png" Style="{StaticResource PixelIcon}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.bond}" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                    </StackPanel>
                    <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding Bond}" Maximum="100" Width="100" Foreground="#E91E63" Margin="0,2,0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_berry_red.png" Style="{StaticResource PixelIcon}" Margin="0,0,3,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.favoriteBerry}" FontSize="11" Foreground="#777" VerticalAlignment="Center"/>
                    </StackPanel>
                    <emoji:TextBlock Text="{Binding FavoriteBerryName}" FontSize="13" FontWeight="Bold" Foreground="#2E7D32" HorizontalAlignment="Center"/>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 🌟 페이지 3 (Value="2"): 전투 능력치 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="2">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="160">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_sword.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.stats}" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <!-- 🌟 속성(타입) 뱃지 표시 영역 추가 -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Border Style="{StaticResource PixelTag}" Background="{Binding Type1, Converter={StaticResource TypeToColor}}" Margin="2">
                            <TextBlock Text="{Binding Type1}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                        <Border Style="{StaticResource PixelTag}" Background="{Binding Type2, Converter={StaticResource TypeToColor}}" Margin="2"
                                Visibility="{Binding HasType2, Converter={StaticResource BoolToVis}}">
                            <TextBlock Text="{Binding Type2}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                        </Border>
                    </StackPanel>

                    <Grid Margin="0,4">
                        <TextBlock Text="{u:T profile.stat.atk}" FontSize="11" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TrAtk}" FontSize="11" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Right"/>
                        <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding TrAtk}" Maximum="100" Foreground="#D32F2F" Margin="0,15,0,0"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="{u:T profile.stat.def}" FontSize="11" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TrDef}" FontSize="11" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Right"/>
                        <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding TrDef}" Maximum="100" Foreground="#1976D2" Margin="0,15,0,0"/>
                    </Grid>
                    <Grid Margin="0,4">
                        <TextBlock Text="{u:T profile.stat.spe}" FontSize="11" FontWeight="Bold" Foreground="#C98F00" HorizontalAlignment="Left"/>
                        <TextBlock Text="{Binding TrSpeed}" FontSize="11" FontWeight="Bold" Foreground="#C98F00" HorizontalAlignment="Right"/>
                        <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding TrSpeed}" Maximum="100" Foreground="#FBC02D" Margin="0,15,0,0"/>
                    </Grid>

                    <Button Content="{u:T profile.wildBattle}" Width="130" Height="30" Margin="0,15,0,0" Style="{StaticResource PixelTextButton}" Background="#E53935" FontWeight="Bold" Cursor="Hand" Click="StartBattle_Click"/>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 🌟 페이지 4 (Value="3"): 보유 스킬 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="3">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="180">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,15">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_clean.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.moves}" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <ItemsControl ItemsSource="{Binding CurrentSkills}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" Rows="2" HorizontalAlignment="Center"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ContentControl Style="{StaticResource PixelTile}" Width="86" Height="46" Margin="2">
                                    <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="10" Foreground="#333" Margin="0,0,0,4" HorizontalAlignment="Center"/>

                                        <!-- 🌟 TypeToColorConverter를 사용하여 타입별로 배경색을 다르게 칠합니다 -->
                                        <Border Style="{StaticResource PixelTag}" Background="{Binding Type, Converter={StaticResource TypeToColor}}" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding Type}" FontSize="9" Foreground="White" FontWeight="Bold"/>
                                        </Border>

                                    </StackPanel>
                                </ContentControl>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 🌟 페이지 5 (Value="4"): 메달 현황 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="4">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_medal.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.medals}" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="{Binding MedalCount, Converter={x:Static lc:LocFormatConverter.Instance}, ConverterParameter=profile.medals.count}" FontSize="11" Foreground="#777" HorizontalAlignment="Center" Margin="0,0,0,10"/>

                    <WrapPanel Width="220" ItemWidth="110" HorizontalAlignment="Center">
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalLv10}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.lv10}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalLv25}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.lv25}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalLv50}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.lv50}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalBerry}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.berry}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalStreak7}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.streak7}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalBond}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.bond}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalFinal}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.final}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                        <ContentControl>
                            <ContentControl.Style>
                                <Style TargetType="ContentControl" BasedOn="{StaticResource MedalBadgeStyle}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasMedalFit}" Value="True">
                                            <Setter Property="Background" Value="#4CC05E"/>
                                            <Setter Property="Foreground" Value="White"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ContentControl.Style>
                            <TextBlock FontWeight="Bold" Text="{u:T medal.fit}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </ContentControl>
                    </WrapPanel>
                </StackPanel>
            </Grid>

            <!-- ========================================== -->
            <!-- 🌟 페이지 6 (Value="5"): 성장 진행도 -->
            <!-- ========================================== -->
            <Grid>
                <Grid.Style>
                    <Style TargetType="Grid">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ProfilePage}" Value="5">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Grid.Style>

                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="160">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <Image Source="/TamaPoke;component/Assets/UI/icon_growth.png" Style="{StaticResource PixelIcon}" Margin="0,0,5,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{u:T profile.growth}" FontSize="16" FontWeight="Bold" Foreground="#333" VerticalAlignment="Center"/>
                    </StackPanel>

                    <TextBlock Text="{u:T profile.nextLevel}" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding LevelProgressMinutes, Mode=OneWay}" Maximum="60" Foreground="#4CAF50" Margin="0,4,0,10"/>

                    <TextBlock Text="{u:T profile.evolution}" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                    <ProgressBar Style="{StaticResource PixelBar}" Value="{Binding EvolveProgressPercent, Mode=OneWay}" Maximum="100" Foreground="#8E24AA" Margin="0,4,0,2"/>
                    <TextBlock Text="{Binding EvolveProgressText}" FontSize="11" Foreground="#8E24AA" HorizontalAlignment="Center" Margin="0,0,0,12"/>

                    <!-- 돌봄 실수 / 몸무게 (퍼펙트 바디 조건) -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{u:T profile.mistakes}" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding CareMistakes, Converter={x:Static lc:LocFormatConverter.Instance}, ConverterParameter=profile.mistakes.count}" FontSize="13" FontWeight="Bold" Foreground="#D32F2F" HorizontalAlignment="Center"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="{u:T profile.weight}" FontSize="11" FontWeight="Bold" Foreground="#555" HorizontalAlignment="Center"/>
                            <TextBlock Text="{Binding Weight, StringFormat={}{0} Kg}" FontSize="13" FontWeight="Bold" Foreground="#1976D2" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>

        </Grid>

        <!-- 하단 페이지 인디케이터 -->
        <TextBlock Text="{Binding ProfilePageDisplay}" FontSize="11" Foreground="#999" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15"/>
    </Grid>
</UserControl>