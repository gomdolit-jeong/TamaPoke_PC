<UserControl x:Class="TamaPoke.Views.MemoGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="320" Width="350">

    <!-- 투명한 버튼 템플릿 -->
    <UserControl.Resources>
        <ControlTemplate x:Key="InvisibleButtonTemplate" TargetType="Button">
            <Grid Background="Transparent"/>
        </ControlTemplate>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- 외곽 그라데이션 테두리 -->
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E53935" Offset="0.0" />
                    <GradientStop Color="#E53935" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- 게임 화면 내부 영역 -->
            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Clip>
                    <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                </Grid.Clip>

                <Border Background="#212121"/>

                <!-- 🌟 좌측 상단: 최고 점수(HI) 표시 추가 -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,55,0,0">
                    <TextBlock Text="HI:" FontSize="12" FontWeight="Bold" Foreground="#9E9E9E" Margin="0,0,5,0"/>
                    <TextBlock Text="{Binding MemoHighScore}" FontSize="12" FontWeight="Bold" Foreground="#9E9E9E"/>
                </StackPanel>

                <!-- 상단 안내 및 현재 점수 표시 -->
                <TextBlock Text="{Binding MemoStatusText}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,25,0,0"/>
                <TextBlock Text="{Binding MemoScore, StringFormat=SCORE: {0}}" Foreground="#FFCA28" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,50,0,0"/>

                <!-- 2x2 색상 버튼 영역 -->
                <Grid Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 0: 빨강 -->
                    <Border Grid.Row="0" Grid.Column="0" Background="#E53935" CornerRadius="80,0,0,0" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#222"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn0Lit}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Cursor="Hand" Click="Btn0_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                    </Border>

                    <!-- 1: 파랑 -->
                    <Border Grid.Row="0" Grid.Column="1" Background="#1E88E5" CornerRadius="0,80,0,0" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#222"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn1Lit}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Cursor="Hand" Click="Btn1_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                    </Border>

                    <!-- 2: 초록 -->
                    <Border Grid.Row="1" Grid.Column="0" Background="#43A047" CornerRadius="0,0,0,80" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#222"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn2Lit}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Cursor="Hand" Click="Btn2_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                    </Border>

                    <!-- 3: 노랑 -->
                    <Border Grid.Row="1" Grid.Column="1" Background="#FDD835" CornerRadius="0,0,80,0" Margin="4">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Opacity" Value="0.3"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#222"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn3Lit}" Value="True">
                                        <Setter Property="Opacity" Value="1.0"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Button Cursor="Hand" Click="Btn3_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                    </Border>
                </Grid>

                <!-- 그만하기 버튼 -->
                <Button Content="그만하기" Width="70" Height="22" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,15" Click="QuitGame_Click" Background="#757575" Foreground="White" FontWeight="Bold" FontSize="11" Cursor="Hand">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="4"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
        </Border>
    </Grid>
</UserControl>