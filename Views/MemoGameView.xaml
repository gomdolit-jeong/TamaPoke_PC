<UserControl x:Class="TamaPoke.Views.MemoGameView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:u="clr-namespace:TamaPoke.Utils"
             Height="320" Width="350">

    <!-- 투명한 버튼 템플릿 -->
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 픽셀 버튼 (대기 화면과 같은 스타일) -->
                <ResourceDictionary Source="/TamaPoke;component/Views/PixelStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <ControlTemplate x:Key="InvisibleButtonTemplate" TargetType="Button">
                <Grid Background="Transparent"/>
            </ControlTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <!-- 외곽 그라데이션 테두리 -->
        <Border Width="320" Height="320" CornerRadius="160" BorderBrush="#333333" BorderThickness="4" ClipToBounds="True">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#E53935" Offset="0.0" />
                    <GradientStop Color="#E53935" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.48" />
                    <GradientStop Color="#222222" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="0.52" />
                    <GradientStop Color="#F5F5F5" Offset="1.0" />
                </LinearGradientBrush>
            </Border.Background>

            <!-- 게임 화면 내부 영역 -->
            <Grid Width="288" Height="288" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid.Clip>
                    <EllipseGeometry Center="144,144" RadiusX="144" RadiusY="144" />
                </Grid.Clip>

                <!-- 픽셀 배경: 조명이 비추는 밤 무대 (96x96 → 3배) -->
                <Image Source="/TamaPoke;component/Assets/UI/bg_game_memo.png" Stretch="Fill" RenderOptions.BitmapScalingMode="NearestNeighbor"/>

                <!-- 🌟 좌측 상단: 최고 점수(HI) 표시 추가 -->
                <Border Style="{StaticResource PixelTag}" Background="#F6F3EA" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="40,55,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="HI:" FontSize="11" FontWeight="Bold" Foreground="#555555" Margin="0,0,4,0"/>
                            <TextBlock Text="{Binding MemoHighScore}" FontSize="11" FontWeight="Bold" Foreground="#333333"/>
                        </StackPanel>
                    </Border>

                <!-- 상단 안내 및 현재 점수 표시 -->
                <TextBlock Text="{Binding MemoStatusText}" Foreground="#FFFFFF" FontSize="16" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,25,0,0"/>
                <TextBlock Text="{Binding MemoScore, StringFormat=SCORE: {0}}" Foreground="#FFCA28" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,50,0,0"/>

                <!-- 2x2 색상 버튼 영역 -->
                <Grid Width="160" Height="160" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- 0: 빨강 -->
                    <Border Grid.Row="0" Grid.Column="0" Margin="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#5A1F23"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#1A1A22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn0Lit}" Value="True">
                                        <Setter Property="Background" Value="#E53935"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Rectangle Fill="#59FFFFFF" Height="4" VerticalAlignment="Top"/>
                            <Rectangle Fill="#38000000" Height="4" VerticalAlignment="Bottom"/>
                            <Button Cursor="Hand" Click="Btn0_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                        </Grid>
                    </Border>

                    <!-- 1: 파랑 -->
                    <Border Grid.Row="0" Grid.Column="1" Margin="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#1D3A5E"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#1A1A22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn1Lit}" Value="True">
                                        <Setter Property="Background" Value="#1E88E5"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Rectangle Fill="#59FFFFFF" Height="4" VerticalAlignment="Top"/>
                            <Rectangle Fill="#38000000" Height="4" VerticalAlignment="Bottom"/>
                            <Button Cursor="Hand" Click="Btn1_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                        </Grid>
                    </Border>

                    <!-- 2: 초록 -->
                    <Border Grid.Row="1" Grid.Column="0" Margin="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#234A2A"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#1A1A22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn2Lit}" Value="True">
                                        <Setter Property="Background" Value="#43A047"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Rectangle Fill="#59FFFFFF" Height="4" VerticalAlignment="Top"/>
                            <Rectangle Fill="#38000000" Height="4" VerticalAlignment="Bottom"/>
                            <Button Cursor="Hand" Click="Btn2_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                        </Grid>
                    </Border>

                    <!-- 3: 노랑 -->
                    <Border Grid.Row="1" Grid.Column="1" Margin="5">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#6B5A1C"/>
                                <Setter Property="BorderThickness" Value="4"/>
                                <Setter Property="BorderBrush" Value="#1A1A22"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMemoBtn3Lit}" Value="True">
                                        <Setter Property="Background" Value="#FDD835"/>
                                        <Setter Property="BorderBrush" Value="#FFF"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Grid>
                            <Rectangle Fill="#59FFFFFF" Height="4" VerticalAlignment="Top"/>
                            <Rectangle Fill="#38000000" Height="4" VerticalAlignment="Bottom"/>
                            <Button Cursor="Hand" Click="Btn3_Click" Template="{StaticResource InvisibleButtonTemplate}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- 그만하기 버튼 -->
                <Button Content="{u:T game.quit}" Width="74" Height="24" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,13" Click="QuitGame_Click" Style="{StaticResource PixelTextButton}" Background="#757575"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>