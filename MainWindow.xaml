<Window x:Class="TamaPoke.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TamaPoke" Height="360" Width="360" 
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        RenderOptions.BitmapScalingMode="NearestNeighbor"
        RenderOptions.EdgeMode="Aliased"
        WindowStyle="None" 
        AllowsTransparency="True" 
        Background="Transparent"
        Topmost="False" 
        Icon="/Assets/Resource/monsterball.ico">

    <!-- 🌟 메인 창 전체 Grid에 마우스 클릭 이벤트를 다시 연결합니다! -->
    <Grid Background="Transparent" MouseLeftButtonDown="MainGrid_MouseLeftButtonDown">

        <!-- 1. 화면이 교체될 빈 공간 (다마포케 320x320 영역) -->
        <ContentControl x:Name="MainContentFrame" HorizontalAlignment="Center" VerticalAlignment="Center" />

        <!-- 2. 컨트롤 패널 (산책 모드일 때 숨겨집니다) -->
        <StackPanel x:Name="ControlPanel" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,10,10,0" Panel.ZIndex="1">

            <Button x:Name="PinButton" Width="24" Height="24" Margin="0,0,8,0" Foreground="White" FontWeight="Bold" Click="PinButton_Click" ToolTip="항상 위 고정 토글">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <!-- 🌟 2. 처음 시작할 때 풀려 있는 상태이므로 어두운 색상(#80000000)으로 시작합니다 -->
                        <Border x:Name="PinBorder" Background="#80000000" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="📌" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Button>

            <Button Content="-" Width="24" Height="24" Margin="0,0,8,0" Foreground="White" FontWeight="Bold" Click="MinimizeButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#80000000" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

            <Button Content="X" Width="24" Height="24" Foreground="White" FontWeight="Bold" Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="#80D32F2F" CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="1,0,0,0"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </Grid>
</Window>